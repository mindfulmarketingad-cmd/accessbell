# Contact form delivery (https://resend.com). Without these the contact API returns 503.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@accessbell.co
CONTACT_FROM_EMAIL=AccessBell <forms@accessbell.co>

# Optional comma-separated extra origins allowed to call /api/* (e.g. a staging domain)
ALLOWED_ORIGINS=

# Real-browser scanning with axe-core. Without it, scans use the HTML-only checker.
# Browserless example: wss://production-sfo.browserless.io?token=YOUR_TOKEN
BROWSER_WS_ENDPOINT=
