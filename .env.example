# ---- Customer dashboard (Supabase) ----
# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://ucqlkhhjoriakjyeogbx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Connect -> Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=

# ---- Billing (Stripe) ----
# Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=
# Optional: defaults to the Lite payment link in server/app/config.js
STRIPE_PAYMENT_LINK=

# ---- Background monitoring (Inngest) ----
# Added automatically by the Inngest Vercel integration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Scanning ----
# Browserless example: wss://production-sfo.browserless.io?token=YOUR_TOKEN
BROWSER_WS_ENDPOINT=

# ---- Email (Resend): contact form and regression alerts ----
RESEND_API_KEY=
EMAIL_FROM=AccessBell <alerts@accessbell.co>
CONTACT_TO_EMAIL=hello@accessbell.co
CONTACT_FROM_EMAIL=AccessBell <forms@accessbell.co>

# Public address of the site, used in alert emails
APP_URL=https://accessbell.co
# Optional comma-separated extra origins allowed to call /api/* (e.g. a staging domain)
ALLOWED_ORIGINS=
