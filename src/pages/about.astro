---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config/site';

const principles = [
  { icon: 'code', title: 'Fix the Source, Not the Symptom', text: 'We do not sell overlays. Durable accessibility comes from fixing the code your site is built on, and our tools are designed around that.' },
  { icon: 'shield', title: 'Honest About Limits', text: 'Automated testing finds a meaningful share of WCAG failures, not all of them. We say so clearly and help you plan for the rest.' },
  { icon: 'eye', title: 'Evidence Over Scores', text: 'A score is useful for trends. What your team needs is the failing element, the criterion and the fix. Every report starts there.' },
  { icon: 'users', title: 'Built for Real Teams', text: 'Developers, content editors, compliance leads and agencies all touch accessibility. AccessBell gives each of them what they need.' },
];

const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about#about`,
    url: `${SITE.url}/about`,
    name: 'About AccessBell',
    about: { '@id': `${SITE.url}/#organization` },
  },
];
---
<BaseLayout
  title="About AccessBell - Website Accessibility Checker Team"
  description="AccessBell builds a website accessibility checker that finds WCAG issues in your code and helps you fix them at the source. Learn about our mission."
  breadcrumbs={[{ label: 'About', href: '/about' }]}
  schema={schema}
>
  <section class="page-hero" aria-labelledby="about-title">
    <div class="container container-narrow">
      <span class="eyebrow">About AccessBell</span>
      <h1 id="about-title">We Help Teams Build Websites That Work for Everyone</h1>
      <p class="lead">
        AccessBell is a website accessibility checker and monitoring platform. We find the barriers that stop people with disabilities from using the web, and we help the teams who own those websites fix them for good.
      </p>
    </div>
  </section>

  <section class="section-tight pt-0">
    <div class="container container-narrow prose">
      <h2>Why We Built AccessBell</h2>
      <p>
        More than a billion people worldwide live with a disability, and many of them rely on screen readers, keyboards, voice control or magnification to use the web. When a website is not built with them in mind, a routine task like paying a bill, booking an appointment or applying for a job becomes impossible.
      </p>
      <p>
        At the same time, website owners face a confusing landscape: WCAG versions, the ADA, Section 508, the European Accessibility Act and a market full of products promising instant compliance. We built AccessBell to cut through that with a simple idea. Test the real code, explain the real problem and make the fix obvious.
      </p>
      <h2>What We Do</h2>
      <p>
        Our <a href="/">website accessibility checker</a> scans pages against WCAG 2.2 success criteria and reports every failure with the element that caused it, why it matters and how to fix it. Our <a href="/pricing">Lite plan</a> extends that to every domain you run, with continuous monitoring, reporting, team permissions and reviewed AI-assisted fix suggestions.
      </p>
      <p>
        We also publish free, practical guidance on the <a href="/blog">AccessBell blog</a>, from a <a href="/blog/wcag-2-2-checklist">WCAG 2.2 checklist</a> to an overview of <a href="/blog/ada-website-compliance-guide">ADA website compliance</a>.
      </p>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our principles</span>
        <h2 id="principles-title">How We Work</h2>
      </div>
      <div class="grid-2 principles">
        {principles.map((p) => (
          <div class="card">
            <div class="icon-tile"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="practice-title">
    <div class="container container-narrow prose">
      <h2 id="practice-title">We Practice What We Check</h2>
      <p>
        This website is built to meet WCAG 2.2 Level AA. It uses semantic HTML, visible focus indicators, sufficient color contrast, labelled forms and works with a keyboard and screen readers. If you find a barrier on any AccessBell page, please <a href="/contact">tell us</a> and we will fix it.
      </p>
      <p>
        Have a question about AccessBell, partnerships or press? <a href="/contact">Get in touch</a>. We read every message.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
