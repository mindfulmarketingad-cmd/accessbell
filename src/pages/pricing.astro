---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ProcessTour from '../components/ProcessTour.astro';
import CostCalculator from '../components/CostCalculator.astro';
import { LAWSUITS } from '../data/lawsuits';
import DemoVideo from '../components/DemoVideo.astro';
import { PLAN, FEATURE_GROUPS } from '../data/pricing';
import { faqSchema, softwareSchema, type FaqItem } from '../lib/schema';

const steps = [
  { tag: 'Step 1', title: 'Automatic Crawl', text: 'We discover pages on your domain, subdomains and XML sitemap, then keep the list current as you publish. You choose which URLs to monitor, up to 500.' },
  { tag: 'Step 2', title: 'Scan', text: 'Each page is tested in a real browser on desktop and mobile against the WCAG level you choose, up to WCAG 2.2 AAA. Issues are ranked by how much they block users.' },
  { tag: 'Step 3', title: 'Improve', text: 'Your team gets the failing elements, grouped by component, with detailed fixing instructions and AI-assisted fix suggestions to review.' },
  { tag: 'Step 4', title: 'Stay Compliant', text: 'Unlimited rescans and continuous monitoring catch regressions as soon as they ship. Your accessibility statement and audit evidence update automatically.' },
];

const faqs: FaqItem[] = [
  {
    q: 'Is the price per domain?',
    a: `Yes. Pro is $${PLAN.price} per domain per month, or $${PLAN.annualPrice} per domain per year when billed annually. Add as many domains as you need, and each one gets ${PLAN.urlsPerDomain} URLs, unlimited rescans and every feature.`,
  },
  {
    q: 'What is the difference between monthly and annual billing?',
    a: `Only the price and how often you pay. Both start with a 3-day free trial and include every feature. Monthly is $${PLAN.price} per domain. Annual is $${PLAN.annualPrice} per domain per year, which saves $${PLAN.price * 12 - PLAN.annualPrice} a year compared with paying monthly.`,
  },
  {
    q: 'What counts as a URL?',
    a: `Each unique page address you monitor counts as one URL. Pro includes up to ${PLAN.urlsPerDomain} URLs per domain. The automatic crawl suggests pages and you choose which ones to monitor. <a href="/solutions/url-monitoring">Learn how URL monitoring works</a>.`,
  },
  {
    q: 'Are rescans really unlimited?',
    a: 'Yes. Rescan your monitored URLs whenever you like, and continuous monitoring runs automatically in the background. A fair-use limit only applies to automated abuse.',
  },
  {
    q: 'Which WCAG levels can I test against?',
    a: 'You can choose Level A, AA or AAA for WCAG 2.0, 2.1 or 2.2. Most organizations target WCAG 2.2 Level AA. Try it free first with our <a href="/resources/wcag-2-2-aa-checker">WCAG 2.2 AA checker</a> or <a href="/resources/ada-compliance-checker">ADA compliance checker</a>.',
  },
  {
    q: 'Is there a free trial?',
    a: 'Yes. Both monthly and annual billing start with a 3-day free trial. Cancel before it ends and you will not be charged. See <a href="/resources/help-center/getting-started/start-your-free-trial">how the free trial works</a>.',
  },
  {
    q: 'Can I cancel at any time?',
    a: 'Yes. Pro is billed monthly and you can cancel whenever you like. Your access continues until the end of the current billing period.',
  },
  {
    q: 'Do you offer an overlay or widget?',
    a: 'Not an overlay that claims to make your site compliant. AccessBell finds issues in your code so they can be fixed at the source. Two optional extras run on your site only if you turn them on: AccessBellFix, a one-line script that applies specific fixes you add and approve, such as missing alt text or button names, while you fix the code; and the <a href="/resources/help-center/domains/pageassist-toolbar">PageAssist toolbar</a>, which lets visitors adjust text size, contrast, spacing and motion for themselves. Neither makes a site conform to WCAG on its own, and neither changes anything you have not approved.',
  },
  {
    q: 'Does AccessBell guarantee legal compliance?',
    a: 'No tool can guarantee legal compliance on its own. AccessBell gives you continuous automated testing, fix guidance and documentation that support a compliance program. See our <a href="/disclaimer">disclaimer</a> for details.',
  },
];
---
<BaseLayout
  title="Pricing - Website Accessibility Checker | AccessBell"
  description={`Start a 3-day free trial of AccessBell Pro: continuous WCAG monitoring of up to ${PLAN.urlsPerDomain} URLs per domain, unlimited rescans and AI-assisted fixes.`}
  breadcrumbs={[{ label: 'Pricing', href: '/pricing' }]}
  schema={[softwareSchema(), faqSchema(faqs)]}
>
  <section class="page-hero page-hero-center" aria-labelledby="pricing-title">
    <div class="container">
      <h1 id="pricing-title">
        <span class="h1-kicker">Website Accessibility Checker Pricing</span>
        Accessibility on <span class="accent">Autopilot</span>
      </h1>
      <p class="lead">One plan for developers, QA and content teams: test every template, track fixes and catch regressions before they ship. Pay per domain, cancel anytime.</p>
      <DemoVideo class="demo-cta-center" />
    </div>
  </section>

  <section class="section-tight pt-0" aria-labelledby="plan-title">
    <div class="container">
      <article class="plan-single">
        <div class="plan-single-main">
          <span class="plan-flag-inline">One plan, every feature</span>
          <h2 id="plan-title">{PLAN.name}</h2>
          <p class="plan-price plan-price-trial">
            <strong>3-Day Free Trial</strong>
          </p>
          <p class="plan-billed">Then ${PLAN.price}/mo per domain, or ${PLAN.annualPrice}/year per domain billed annually. Same features on both.</p>
          <p class="plan-blurb">{PLAN.blurb}</p>
          <ul class="check-list">
            {PLAN.highlights.map((h) => <li><Icon name="check" />{h}</li>)}
          </ul>
          <div class="plan-options">
            <div class="plan-option">
              <h3 class="plan-option-name">Monthly</h3>
              <p class="plan-option-price"><strong>${PLAN.price}</strong> /mo per domain</p>
              <p class="plan-option-note">3-day free trial. Cancel anytime.</p>
              <a class="btn btn-accent btn-block" href={PLAN.ctaHref}>{PLAN.cta} <Icon name="arrow" /></a>
            </div>
            <div class="plan-option plan-option-annual">
              <h3 class="plan-option-name">Annual <span class="plan-save">Save {Math.round((1 - PLAN.annualPrice / (PLAN.price * 12)) * 100)}%</span></h3>
              <p class="plan-option-price"><strong>${PLAN.annualPrice}</strong> /year per domain</p>
              <p class="plan-option-note">3-day free trial. Works out to ${(PLAN.annualPrice / 12).toFixed(2)}/mo, saving ${PLAN.price * 12 - PLAN.annualPrice} a year.</p>
              <a class="btn btn-block" href={PLAN.annualCtaHref}>{PLAN.cta} <Icon name="arrow" /></a>
            </div>
          </div>
          <p class="plan-note">Need more than {PLAN.urlsPerDomain} URLs per domain? <a href="/contact?topic=sales">Talk to us</a>.</p>
        </div>
        <div class="plan-single-features">
          <h3>Everything Included</h3>
          <div class="feature-groups">
            {FEATURE_GROUPS.map((g) => (
              <div class="feature-group">
                <h4>{g.title}</h4>
                <ul class="check-list">
                  {g.features.map((f) => <li><Icon name="check" />{f}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="calc-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cost calculator</span>
        <h2 id="calc-title">How Much Could <span class="accent">You Save?</span></h2>
        <p>Testing every page by hand, every time your site changes, adds up fast. Enter a few details to compare it with a flat ${PLAN.price} per domain per month.</p>
      </div>
      <CostCalculator />
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="suits-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Lawsuit examples</span>
        <h2 id="suits-title">What Being Sued <span class="accent">Actually Costs</span></h2>
        <p>Businesses of every size have been sued over inaccessible websites. Here is what some of them paid, next to what a year of AccessBell Pro costs: ${PLAN.annualPrice} per domain on the annual plan.</p>
      </div>
      <ul class="suit-grid">
        {LAWSUITS.map((s) => (
          <li class="suit-card">
            <p class="suit-head"><strong>{s.company}</strong><span class="tag">{s.year}</span></p>
            <p>{s.what}</p>
            <p class="suit-cost"><Icon name="scale" /><span>{s.cost}</span></p>
            {s.paid ? (
              <p class="suit-years">Equal to <strong>{Math.floor(s.paid / PLAN.annualPrice).toLocaleString('en-US')} years</strong> of AccessBell Pro for one domain</p>
            ) : null}
            <p class="suit-source">Source: {s.source.url.startsWith('/')
              ? <a href={s.source.url}>{s.source.label}</a>
              : <a href={s.source.url} rel="noopener noreferrer">{s.source.label}</a>}</p>
          </li>
        ))}
      </ul>
      <div class="suit-note">
        <p><strong>How AccessBell helps you avoid this.</strong> The barriers named in many complaints, such as missing alt text, unlabeled form fields and buttons with no name, are ones automated scans find. AccessBell scans up to {PLAN.urlsPerDomain} pages per domain every day, shows you the failing code and how to fix it, and keeps a dated record of every scan and fix. You pay to fix your site either way. The difference is whether you do it on your schedule or after a complaint.</p>
        <p class="muted">"Years of Pro" divides the amount paid by ${PLAN.annualPrice}, one year of Pro for one domain on the annual plan. It is not a claim that AccessBell would have prevented these cases, and no tool can guarantee you will not be sued. Read <a href="/blog/what-happens-after-being-sued-for-ada-website-compliance">what happens after being sued for violating ADA website compliance</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 id="process-title">Every Problem Has a Process. <span class="accent">Here Is Ours.</span></h2>
        <p>A repeatable loop that takes you from first scan to continuous compliance.</p>
      </div>
      <ProcessTour steps={steps} />
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="ai-title">
    <div class="container grid-2">
      <div class="feature-copy">
        <span class="eyebrow">AI-assisted fixes</span>
        <h2 id="ai-title">AI-Assisted Fixes, <span class="accent">Done Responsibly</span></h2>
        <p class="lead">Suggestions speed up remediation. Your team stays in control of every change.</p>
        <ul class="check-list">
          <li><Icon name="check" /><span><strong>Grounded in WCAG.</strong> Every suggestion cites the <a href="https://www.w3.org/TR/WCAG22/" rel="noopener noreferrer">WCAG 2.2</a> success criterion it resolves.</span></li>
          <li><Icon name="check" /><span><strong>Reviewed, never auto-applied.</strong> Nothing changes on your site until a person approves it.</span></li>
          <li><Icon name="check" /><span><strong>Context aware.</strong> Suggestions use surrounding content, so alt text and labels start from something meaningful.</span></li>
          <li><Icon name="check" /><span><strong>Private by design.</strong> Your code is not used to train third-party models.</span></li>
        </ul>
        <p><a href="/solutions/automated-fixes">See how AccessBellFix can automatically fix website accessibility issues</a>, or read about <a href="/solutions/continuous-monitoring">continuous monitoring</a> and the <a href="/solutions/compliance-vault">Compliance Vault</a>.</p>
        <a class="btn" href={PLAN.ctaHref}>{PLAN.cta} <Icon name="arrow" /></a>
      </div>
      <div class="mock" role="img" aria-label="Illustration of a suggested code fix adding a label to an email input field">
        <div class="mock-bar" aria-hidden="true"><i></i><i></i><i></i><span>Suggested fix - WCAG 1.3.1</span></div>
        <div class="mock-body" aria-hidden="true">
          <div class="mock-row"><span><span class="dot dot-red"></span><strong>Form field has no label</strong></span><span class="tag tag-critical">Critical</span></div>
          <div class="mock-code"><span class="del">- &lt;input type="email" placeholder="Email"&gt;</span>
<span class="add">+ &lt;label for="email"&gt;Email address&lt;/label&gt;</span>
<span class="add">+ &lt;input id="email" type="email"</span>
<span class="add">+   autocomplete="email"&gt;</span></div>
          <div class="mock-row"><span><span class="dot"></span><strong>Awaiting review</strong></span><span class="tag tag-pass">Approve</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="dash-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Dashboard</span>
        <h2 id="dash-title">Accessibility Dashboard at a Glance</h2>
        <p>A domain-wide compliance overview for every domain you manage, in one multi-domain view.</p>
      </div>
      <div class="grid-2">
        <div class="mock" role="img" aria-label="Illustration of the dashboard: score 94, 25 URLs monitored, 37 open issues and an upward trend">
          <div class="mock-bar" aria-hidden="true"><i></i><i></i><i></i><span>example.com - Overview</span></div>
          <div class="mock-body" aria-hidden="true">
            <div class="mock-kpis">
              <div><span>Score</span><strong>94</strong></div>
              <div><span>URLs</span><strong>25</strong></div>
              <div><span>Open issues</span><strong>37</strong></div>
            </div>
            <div class="bars"><i class="h-30"></i><i class="h-38"></i><i class="h-45"></i><i class="h-52"></i><i class="h-60"></i><i class="h-68"></i><i class="h-77"></i><i class="h-86"></i><i class="h-94"></i></div>
            <div class="mock-score">
              <div class="score-ring pct-94"><span>94</span></div>
              <div><strong>WCAG 2.2 AA</strong><p>Up 22 points in 9 weeks</p></div>
            </div>
          </div>
        </div>
        <div class="grid-3 dash-cards">
          <div class="card">
            <div class="icon-tile"><Icon name="doc" /></div>
            <h3>Auto-Updating Statement</h3>
            <p>Publish an accessibility statement that updates itself as your conformance changes, with a way for users to reach you.</p>
          </div>
          <div class="card">
            <div class="icon-tile"><Icon name="layers" /></div>
            <h3>Audit-Ready Reporting</h3>
            <p>Export PDF and Excel reports by domain, criterion or date range, with audit evidence collected automatically.</p>
          </div>
          <div class="card">
            <div class="icon-tile"><Icon name="bell" /></div>
            <h3>Email Notifications</h3>
            <p>Get an email when a deploy introduces a new critical issue, with a link straight to the failing element.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="pfaq-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2 id="pfaq-title">Frequently Asked Questions</h2>
        <p>Have another question? <a href="/contact">Contact our team</a>.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand title="See Where Your Site Stands Today" text="Run a free WCAG 2.2 scan on any page, then monitor your whole domain with Pro." />
</BaseLayout>
