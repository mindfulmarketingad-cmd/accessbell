---
import AuthLayout from '../../layouts/AuthLayout.astro';
---
<AuthLayout title="Create your account">
  <h1>Create your account</h1>
  <p>Start with a 3-day free trial of AccessBell Lite. $79 per domain per month after the trial.</p>
  <form class="form" data-auth-form="signup" novalidate>
    <div class="field">
      <label for="email">Work email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
    </div>
    <div class="field">
      <label for="password">Password <span class="hint">(at least 8 characters)</span></label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="72" />
    </div>
    <p class="muted mb-0">By creating an account you agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</p>
    <p class="status-line" data-status role="status" aria-live="polite"></p>
    <button class="btn btn-lg btn-accent" type="submit">Create account</button>
  </form>
  <div data-confirm hidden>
    <h1 tabindex="-1">Check your email</h1>
    <p>We sent a confirmation link to <strong data-email></strong>. Open it to finish creating your account.</p>
  </div>
  <p class="auth-alt">Already have an account? <a href="/app/login">Sign in</a></p>
</AuthLayout>
<script>
  import '../../scripts/app/auth.js';
</script>
