---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
---
<AppLayout title="Your Domains" section="overview">
  <header class="page-top">
    <h1>Your Domains <span class="count-badge" data-domain-count>0</span></h1>
    <button class="btn" type="button" data-open-add hidden><Icon name="plus" /> Add Domain</button>
  </header>

  <div class="list-tools" data-list-tools hidden>
    <label class="search-field">
      <Icon name="search" />
      <span class="visually-hidden">Search domains</span>
      <input type="search" placeholder="Search domains" data-domain-search autocomplete="off" />
    </label>
  </div>
  <p class="status-line" data-list-status role="status" aria-live="polite"></p>
  <div data-domains><p class="muted">Loading...</p></div>
</AppLayout>
<script>
  import '../../scripts/app/overview.js';
</script>
