---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
---
<AppLayout title="Domain" section="overview">
  <header class="domain-top">
    <a class="icon-btn" href="/app"><Icon name="back" /><span class="visually-hidden">Back to all domains</span></a>
    <span data-domain-avatar></span>
    <div class="domain-title">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/app">Domains</a></li></ol></nav>
      <h1 data-title>Loading...</h1>
    </div>
    <div class="top-actions">
      <span class="last-scan" data-last-scan hidden><Icon name="clock" /><span></span></span>
      <button class="btn btn-scan" type="button" data-rescan-all hidden><Icon name="refresh" /> Scan now</button>
      <div class="menu-wrap">
        <button class="btn btn-outline" type="button" data-export aria-expanded="false" aria-controls="export-menu"><Icon name="download" /> Export <Icon name="chevron" /></button>
        <div class="menu menu-down" id="export-menu" hidden>
          <button type="button" data-export-csv><Icon name="doc" /> Fixing instructions (CSV for Excel)</button>
          <button type="button" data-export-print><Icon name="print" /> PDF summary (print or save as PDF)</button>
          <button type="button" data-export-vault><Icon name="shield" /> Legal evidence package</button>
        </div>
      </div>
      <div data-domain-menu></div>
    </div>
  </header>
  <p class="progress-note" data-progress role="status" aria-live="polite"></p>

  <div class="app-tabs" data-tabs>
    <div class="tablist" role="tablist" aria-label="Domain views">
      <button type="button" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true" tabindex="0"><Icon name="chart" /> Overview</button>
      <button type="button" role="tab" id="tab-issues" aria-controls="panel-issues" aria-selected="false" tabindex="-1"><Icon name="alert" /> Issues <span class="tab-count" data-count-issues></span></button>
      <button type="button" role="tab" id="tab-review" aria-controls="panel-review" aria-selected="false" tabindex="-1"><Icon name="eye" /> Manually Required <span class="tab-count" data-count-review></span></button>
      <button type="button" role="tab" id="tab-vault" aria-controls="panel-vault" aria-selected="false" tabindex="-1"><Icon name="shield" /> Compliance Vault</button>
      <button type="button" role="tab" id="tab-pages" aria-controls="panel-pages" aria-selected="false" tabindex="-1"><Icon name="list" /> Pages</button>
      <button type="button" role="tab" id="tab-settings" aria-controls="panel-settings" aria-selected="false" tabindex="-1"><Icon name="gear" /> Settings</button>
    </div>

    <div role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" tabindex="0">
      <div class="fix-promo" data-fix-promo hidden>
        <span class="fix-promo-icon" aria-hidden="true"><Icon name="sparkle" /></span>
        <div>
          <h2>Fix issues without touching your code</h2>
          <p>Install the AccessBellFix snippet, then apply fixes such as missing alt text and button names from here. You review and approve every fix before it goes live.</p>
        </div>
        <button class="btn" type="button" data-goto-fix>Set up AccessBellFix</button>
      </div>
      <div class="ov-grid">
        <section class="box" aria-labelledby="lso-title">
          <h2 id="lso-title" class="box-title">Last scan results</h2>
          <div class="lso" data-lso></div>
        </section>
        <section class="box" aria-labelledby="hist-title">
          <div class="box-head">
            <h2 id="hist-title" class="box-title">Scan history</h2>
            <label class="select-sm">
              <span class="visually-hidden">Time range</span>
              <select data-range>
                <option value="7">Last 7 days</option>
                <option value="30" selected>Last 30 days</option>
                <option value="90">Last 90 days</option>
              </select>
            </label>
          </div>
          <div data-history></div>
        </section>
      </div>

      <section class="coverage" aria-labelledby="cov-title">
        <div class="coverage-head">
          <div>
            <h2 id="cov-title">Test Coverage by WCAG Principle</h2>
            <p data-cov-sub>Every success criterion in your target, grouped by principle, with what automated testing found and what needs a person to check.</p>
          </div>
          <div class="coverage-tools">
            <label class="check-inline"><input type="checkbox" data-cov-issues-only /> Only criteria with issues</label>
            <button class="btn btn-outline" type="button" data-goto="settings"><Icon name="gear" /> Domain Settings</button>
          </div>
        </div>
        <div data-coverage></div>
      </section>

      <section class="box" aria-labelledby="components-title">
        <h2 id="components-title" class="box-title">Component grouping</h2>
        <p class="muted">The same failing element on several pages. Fix it once in the shared component.</p>
        <div data-components></div>
      </section>
    </div>

    <div role="tabpanel" id="panel-issues" aria-labelledby="tab-issues" tabindex="0" hidden>
      <h2 class="visually-hidden">Issues</h2>
      <div class="issues-head">
        <p class="muted" data-issues-sub></p>
        <label class="select-sm">
          <span>Severity</span>
          <select data-issue-filter>
            <option value="">All</option>
            <option value="critical">Critical</option>
            <option value="serious">Serious</option>
            <option value="moderate">Moderate</option>
            <option value="minor">Minor</option>
          </select>
        </label>
      </div>
      <div data-rules></div>
    </div>

    <div role="tabpanel" id="panel-review" aria-labelledby="tab-review" tabindex="0" hidden>
      <h2 class="visually-hidden">Manually required</h2>
      <p class="muted">Automated testing flagged these for a person to check. They are not counted as failures. Every success criterion also needs a manual check to confirm conformance; see the coverage table on the Overview tab.</p>
      <div data-review></div>
    </div>

    <div role="tabpanel" id="panel-vault" aria-labelledby="tab-vault" tabindex="0" hidden>
      <h2 class="visually-hidden">Compliance Vault</h2>
      <p class="vault-intro">Your audit-ready accessibility history and compliance evidence, kept automatically.</p>
      <div data-vault><p class="muted">Loading...</p></div>
    </div>

    <div role="tabpanel" id="panel-pages" aria-labelledby="tab-pages" tabindex="0" hidden>
      <section class="panel" aria-labelledby="monitored-title">
        <h2 id="monitored-title">Monitored URLs</h2>
        <p class="panel-sub" data-monitored-count></p>
        <form class="inline-form" data-add-page novalidate>
          <div class="field">
            <label for="page-url">Add a URL</label>
            <input id="page-url" name="url" type="text" inputmode="url" placeholder="/pricing or https://example.com/pricing" maxlength="2048" />
          </div>
          <button class="btn" type="submit">Add and monitor</button>
        </form>
        <p class="status-line" data-page-status role="status" aria-live="polite"></p>
        <div data-monitored></div>
      </section>
      <section class="panel" aria-labelledby="found-title">
        <h2 id="found-title">Discovered pages</h2>
        <p class="panel-sub">Found by the automatic crawl and sitemap scan. Choose which ones to monitor.</p>
        <div data-found></div>
      </section>
    </div>

    <div role="tabpanel" id="panel-settings" aria-labelledby="tab-settings" tabindex="0" hidden>
      <form class="panel" data-settings novalidate aria-labelledby="settings-title">
        <h2 id="settings-title">Scan settings</h2>
        <p class="panel-sub">Applied to every scan of this domain, including scheduled monitoring.</p>
        <div class="form-grid cols-2">
          <div class="field">
            <label for="s-version">WCAG version</label>
            <select id="s-version" name="wcagVersion"><option>2.2</option><option>2.1</option><option>2.0</option></select>
          </div>
          <div class="field">
            <label for="s-level">Conformance level</label>
            <select id="s-level" name="wcagLevel"><option>A</option><option selected>AA</option><option>AAA</option></select>
          </div>
          <fieldset class="field">
            <legend>Devices</legend>
            <div class="check-row">
              <label><input type="checkbox" name="device" value="desktop" /> Desktop</label>
              <label><input type="checkbox" name="device" value="mobile" /> Mobile</label>
            </div>
          </fieldset>
          <fieldset class="field">
            <legend>Coverage</legend>
            <div class="check-row">
              <label><input type="checkbox" name="includeSubdomains" /> Include subdomains</label>
              <label><input type="checkbox" name="scroll" /> Scroll the page before testing</label>
            </div>
          </fieldset>
          <div class="field">
            <label for="s-delay">Page load delay (milliseconds)</label>
            <input id="s-delay" name="delayMs" type="number" min="0" max="10000" step="100" />
            <span class="help">Wait for animations or late content before testing. 0 to 10,000.</span>
          </div>
          <div class="field">
            <label for="s-sitemap">XML sitemap <span class="hint">(optional)</span></label>
            <input id="s-sitemap" name="sitemapUrl" type="text" inputmode="url" maxlength="2048" placeholder="https://example.com/sitemap.xml" />
            <span class="help">Read first when finding pages. Use Manage domain pages to find pages again.</span>
          </div>
          <div class="field">
            <label for="s-include">Only include URLs matching <span class="hint">(optional)</span></label>
            <textarea id="s-include" name="include" rows="3" placeholder="/docs/*"></textarea>
            <span class="help">One rule per line. Use * as a wildcard.</span>
          </div>
          <div class="field">
            <label for="s-exclude">Exclude URLs matching <span class="hint">(optional)</span></label>
            <textarea id="s-exclude" name="exclude" rows="3" placeholder="/blog/tag/*"></textarea>
            <span class="help">Applied when discovering pages.</span>
          </div>
        </div>
        <fieldset class="field">
          <legend>Custom HTTP headers</legend>
          <p class="help">For staging environments, for example an Authorization header. Headers are only sent to this domain, and saved values are never shown again.</p>
          <div class="header-rows" data-header-rows></div>
          <button class="btn btn-outline btn-sm" type="button" data-add-header>Add header</button>
        </fieldset>
        <p class="status-line" data-settings-status role="status" aria-live="polite"></p>
        <button class="btn" type="submit">Save settings</button>
      </form>
      <section class="panel" id="accessbellfix" aria-labelledby="fix-title" tabindex="-1">
        <h2 id="fix-title">AccessBellFix</h2>
        <p class="panel-sub">Apply the fixes you approve, such as image alt text, button names and the page language, without editing your site's code. Optional.</p>
        <div data-fix-install><p class="muted">Loading...</p></div>
        <h3 class="panel-h3">Your fixes</h3>
        <div data-fix-list></div>
      </section>
      <section class="panel" id="statement" aria-labelledby="statement-title" tabindex="-1">
        <h2 id="statement-title">Accessibility statement</h2>
        <p class="panel-sub">Your public accessibility statement: your commitment, the standard you follow and how people can report a barrier.</p>
        <div data-statement><p class="muted">Loading...</p></div>
      </section>
      <section class="panel" aria-labelledby="danger-title" data-danger>
        <h2 id="danger-title">Remove domain</h2>
        <p class="panel-sub">Deletes the domain, its pages and all scan history. This cannot be undone.</p>
        <button class="btn btn-danger" type="button" data-delete-domain>Remove domain</button>
      </section>
    </div>
  </div>
</AppLayout>
<script>
  import '../../scripts/app/domain.js';
</script>
