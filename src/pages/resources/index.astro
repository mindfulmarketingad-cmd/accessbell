---
import { coverFor } from '../../lib/covers';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../config/site';
import { formatDate } from '../../lib/format';
import { helpByCategory } from '../../lib/help';
import { CHECKERS, checkerPath } from '../../data/checkers';
import { PLATFORMS, platformPath } from '../../data/platforms';
import { INDUSTRIES, industryPath } from '../../data/industries';
import { STATE_LAWS, stateLawPath } from '../../data/state-laws';

const helpCount = (await helpByCategory()).reduce((n, g) => n + g.articles.length, 0);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tools = [
  { href: '/#scan', icon: 'scan', title: 'Free Website Accessibility Checker', text: 'Scan any public page against WCAG 2.2, 2.1, ADA, Section 508 or EN 301 549 and get a report with fixes in seconds.', tag: 'Free tool' },
  { href: '/resources/statement-generator', icon: 'doc', title: 'Accessibility Statement Generator', text: 'Create a custom accessibility statement for your website, then copy it or download it as an HTML page.', tag: 'Free tool' },
  { href: '/resources/free-accessibility-icon-set', icon: 'layers', title: 'Free Accessibility Icon Set', text: '17 original accessibility icons for wheelchair access, captions, sign language, braille and more, as SVG and PNG.', tag: 'Free download' },
  { href: '/resources/contrast-checker', icon: 'eye', title: 'WCAG Color Contrast Checker', text: 'Check any two colors against WCAG 2.2 contrast requirements for normal text, large text and UI components.', tag: 'Free tool' },
  { href: '/resources/chart-color-checker', icon: 'chart', title: 'Chart Color Checker', text: 'Check chart and infographic colors for 3:1 contrast and see whether people with color blindness can tell them apart.', tag: 'Free tool' },
  { href: '/resources/wcag', icon: 'list', title: 'WCAG Success Criteria Library', text: 'All 87 WCAG success criteria explained: what each one requires, how to test it, common failures and whether AccessBell automates it.', tag: 'Reference' },
  { href: '/resources/help-center', icon: 'chat', title: 'Help Center', text: 'Step-by-step guides for everything in AccessBell, from your first scan to monitoring every domain you run.', tag: `${helpCount} articles` },
  { href: '/blog/wcag-2-2-checklist', icon: 'check-circle', title: 'WCAG 2.2 Checklist', text: 'Every WCAG 2.2 Level A and AA requirement in plain language, with what changed and how to test each one.', tag: 'Guide' },
  { href: '/blog', icon: 'layers', title: 'Accessibility Blog', text: 'Guides on WCAG, the ADA, testing tools and the legal process, written for website owners and teams.', tag: `${posts.length} articles` },
  { href: '/pricing', icon: 'chart', title: 'Continuous Monitoring', text: 'Monitor up to 25 URLs per domain with scheduled scans, alerts, history and team roles. 3-day free trial.', tag: 'AccessBell Pro' },
];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/resources#webpage`,
    name: 'Accessibility Resources',
    url: `${SITE.url}/resources`,
    hasPart: tools.map((t) => ({ '@type': 'WebPage', name: t.title, url: `${SITE.url}${t.href.replace('/#scan', '/')}` })),
  },
];
---
<BaseLayout
  title="Accessibility Resources and Free Tools | AccessBell"
  description="Free web accessibility resources from AccessBell: a WCAG checker, an accessibility statement generator, the Help Center, a WCAG 2.2 checklist and guides."
  breadcrumbs={[{ label: 'Resources', href: '/resources' }]}
  schema={schema}
>
  <section class="page-hero page-hero-center" aria-labelledby="res-title">
    <div class="container">
      <h1 id="res-title">
        <span class="h1-kicker">Free Tools and Guides</span>
        Accessibility <span class="accent">Resources</span>
      </h1>
      <p class="lead">Free checkers, checklists and guides for developers, QA testers and content creators. Find, fix and document accessibility issues in one place, tested against the W3C's <a href="https://www.w3.org/TR/WCAG22/" rel="noopener noreferrer">WCAG 2.2</a>. Looking for something specific? Browse the <a href="/sitemap">full sitemap</a>.</p>
    </div>
  </section>

  <section class="section-tight pt-0" aria-labelledby="res-tools">
    <div class="container">
      <h2 id="res-tools" class="visually-hidden">Tools and guides</h2>
      <ul class="res-grid">
        {tools.map((t) => (
          <li>
            <a class="res-card" href={t.href}>
              <span class="help-cat-icon"><Icon name={t.icon} /></span>
              <span class="res-card-text">
                <small>{t.tag}</small>
                <strong>{t.title}</strong>
                <span>{t.text}</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="res-checkers">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="res-checkers">Free Checkers by Standard</h2>
        <p>The same free scanner, preset for the standard you need to meet, with a full breakdown of what it tests.</p>
      </div>
      <ul class="res-grid">
        {CHECKERS.map((c) => (
          <li>
            <a class="res-card" href={checkerPath(c)}>
              <span class="res-card-text">
                <small>WCAG {c.version} Level {c.level}</small>
                <strong>{c.name}</strong>
                <span>{c.lead.split('. ')[0]}.</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="res-platforms">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="res-platforms">Free Checkers by Platform</h2>
        <p>The same free scanner, framed for the CMS or e-commerce platform your site runs on, with the issues that platform sees most.</p>
      </div>
      <ul class="res-grid">
        {PLATFORMS.map((p) => (
          <li>
            <a class="res-card" href={platformPath(p)}>
              <span class="res-card-text">
                <small>Free Tool</small>
                <strong>{p.name} Accessibility Checker</strong>
                <span>{p.lead}</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
      </ul>
      <p class="more-link"><a class="link-arrow" href="/platforms">All platform accessibility checkers <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="res-industries">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="res-industries">Free Checkers by Industry</h2>
        <p>The same free scanner, framed for the compliance rules and common failures in your industry.</p>
      </div>
      <ul class="res-grid">
        {INDUSTRIES.map((ind) => (
          <li>
            <a class="res-card" href={industryPath(ind)}>
              <span class="res-card-text">
                <small>Free Tool</small>
                <strong>{ind.name} Accessibility Checker</strong>
                <span>{ind.lead}</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
      </ul>
      <p class="more-link"><a class="link-arrow" href="/industries">All industry accessibility checkers <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="res-states">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="res-states">Free Checkers by State</h2>
        <p>The same free scanner, with the accessibility litigation landscape for the state you operate in.</p>
      </div>
      <ul class="res-grid">
        {STATE_LAWS.map((st) => (
          <li>
            <a class="res-card" href={stateLawPath(st)}>
              <span class="res-card-text">
                <small>Free Tool</small>
                <strong>{st.name} Website Accessibility Checker</strong>
                <span>{st.lead}</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
      </ul>
      <p class="more-link"><a class="link-arrow" href="/state-accessibility-laws">All state website accessibility laws <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="res-latest">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="res-latest">Latest Guides</h2>
      </div>
      <div class="post-grid">
        {posts.slice(0, 3).map((p) => (
          <article class="post-card">
            {coverFor(p.id) && <img class="post-card-img" src={coverFor(p.id)!.src} width="1200" height="630" alt="" loading="lazy" decoding="async" />}
            <div class="post-card-body">
              <span class="eyebrow">{p.data.category}</span>
              <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
              <div class="post-meta"><time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time></div>
            </div>
          </article>
        ))}
      </div>
      <p class="more-link"><a class="link-arrow" href="/blog">All articles <Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
