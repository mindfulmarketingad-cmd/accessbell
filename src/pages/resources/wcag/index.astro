---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { SITE } from '../../../config/site';
import { CRITERIA, PRINCIPLES } from '../../../../server/wcag-criteria.js';
import { criterionPath, rulesForCriterion } from '../../../lib/wcag-pages';
import { CHECKERS, checkerPath } from '../../../data/checkers';

const scRank = (sc: string) => sc.split('.').map(Number);
const cmp = (a: string, b: string) => {
  const [a1, a2, a3] = scRank(a);
  const [b1, b2, b3] = scRank(b);
  return a1 - b1 || a2 - b2 || a3 - b3;
};

const all = Object.values(CRITERIA)
  .filter((c) => c.sc !== '4.1.1') // obsolete in WCAG 2.2; still has its own page, just not listed here
  .map((c) => ({ ...c, ruleCount: rulesForCriterion(c.sc).length }))
  .sort((a, b) => cmp(a.sc, b.sc));

const groups = Object.values(PRINCIPLES).map((p) => ({ principle: p, criteria: all.filter((c) => c.principle === p) }));
const automated = all.filter((c) => c.ruleCount > 0).length;

const url = `${SITE.url}/resources/wcag`;
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    name: 'WCAG Success Criteria Library',
    url,
    description: 'Every WCAG 2.2 success criterion explained, with what it requires, how to test it and which AccessBell checker automates it.',
    isPartOf: { '@id': `${SITE.url}/#website` },
    hasPart: all.map((c) => ({ '@type': 'WebPage', name: `${c.sc} ${c.name}`, url: `${SITE.url}${criterionPath(c.sc)}` })),
  },
];
---
<BaseLayout
  title="WCAG Success Criteria Library: Every Criterion Explained | AccessBell"
  description="All 87 WCAG success criteria in one library. Plain-language explanations, how to test each one, common failures, and which ones AccessBell's checker automates."
  breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'WCAG Success Criteria', href: '/resources/wcag' }]}
  schema={schema}
>
  <section class="page-hero" aria-labelledby="wcag-title">
    <div class="container">
      <h1 id="wcag-title"><span class="h1-kicker">Reference Library</span>WCAG <span class="accent">Success Criteria</span> Explained</h1>
      <p class="lead">Every success criterion from WCAG 2.0 through 2.2, in one place: what it requires, how to test it by hand, the failures we see most, and whether AccessBell's automated checker can catch it for you.</p>
    </div>
  </section>

  <article class="container checker-body">
    <section aria-labelledby="wcag-intro">
      <h2 id="wcag-intro" class="visually-hidden">About this library</h2>
      <p>WCAG groups its 87 success criteria under four principles &mdash; Perceivable, Operable, Understandable and Robust &mdash; and three conformance levels, A, AA and AAA. Most legal standards, including the ADA, Section 508 and the European Accessibility Act, point to Level AA. {automated} of the 87 criteria have at least one axe-core rule that can catch a failure automatically; the rest need a person to judge, and every page here says which is which.</p>
      <p>Looking for a scan instead of a reference page? Run the free checker built for the standard you need: {CHECKERS.map((c, i) => <>{i > 0 && ', '}<a href={checkerPath(c)}>{c.name}</a></>)}.</p>
    </section>

    <section aria-labelledby="wcag-groups">
      <h2 id="wcag-groups" class="visually-hidden">Success criteria by principle</h2>
      {groups.map((g, i) => (
        <details class="cov-group" open={i === 0}>
          <summary>{g.principle} <span>{g.criteria.length} criteria, {g.criteria.filter((c) => c.ruleCount > 0).length} automated</span></summary>
          <div class="table-scroll" role="region" aria-label={`${g.principle} success criteria`} tabindex="0">
            <table class="cov-list">
              <caption class="visually-hidden">{g.principle} success criteria</caption>
              <thead><tr><th scope="col">Success criterion</th><th scope="col">Level</th><th scope="col">Added in</th><th scope="col">How it is tested</th></tr></thead>
              <tbody>
                {g.criteria.map((c) => (
                  <tr>
                    <th scope="row"><a href={criterionPath(c.sc)}><span class="sc-no">{c.sc}</span> {c.name}</a></th>
                    <td>{c.level}</td>
                    <td>WCAG {c.version}</td>
                    <td>{c.ruleCount > 0 ? <span class="cov-auto"><Icon name="check" /> Automated</span> : <span class="cov-manual"><Icon name="eye" /> Manual review</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </section>
  </article>

  <CtaBand
    title="Run a Free Scan Against Any of These Criteria"
    text="Test a live page against WCAG 2.2, 2.1 or 2.0 and see exactly which criteria pass, fail or need a manual look."
  />
</BaseLayout>
