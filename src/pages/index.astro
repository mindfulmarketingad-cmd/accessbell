---
import { coverFor } from '../lib/covers';
import { postPath } from '../lib/posts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDemo from '../components/HeroDemo.astro';
import ScanForm from '../components/ScanForm.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Flag from '../components/Flag.astro';
import { Picture } from 'astro:assets';
import ownerPhoto from '../assets/website-owner-at-laptop.jpg';
import { faqSchema, softwareSchema, type FaqItem } from '../lib/schema';
import { formatDate, readingTime } from '../lib/format';
import { LAWSUIT_STATS } from '../data/lawsuit-stats';
import DemoVideo from '../components/DemoVideo.astro';
import PlatformLogo from '../components/PlatformLogo.astro';
import { PLATFORMS, platformHome } from '../data/platforms';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const standards = [
  { name: 'WCAG 2.2', sub: 'W3C Recommendation, Levels A and AA', flag: 'intl', href: '/resources/wcag-2-2-aa-checker' },
  { name: 'ADA', sub: 'Titles II and III, United States', flag: 'us', href: '/resources/ada-compliance-checker' },
  { name: 'Section 508', sub: 'U.S. federal ICT', flag: 'us', href: '/resources/section-508-checker' },
  { name: 'EN 301 549', sub: 'European Union harmonized standard', flag: 'eu', href: '/resources/en-301-549-checker' },
  { name: 'AODA', sub: 'Ontario, Canada', flag: 'ca', href: undefined },
  { name: 'EAA', sub: 'European Accessibility Act', flag: 'eu', href: '/resources/en-301-549-checker' },
] as const;

// Standards named under the scanner, with the jurisdiction each belongs to.
const compliance = [
  { name: 'WCAG', flag: 'intl', href: '/resources/wcag-2-2-aa-checker' },
  { name: 'ADA', flag: 'us', href: '/resources/ada-compliance-checker' },
  { name: 'EAA', flag: 'eu', href: '/resources/en-301-549-checker' },
  { name: 'Section 508', flag: 'us', href: '/resources/section-508-checker' },
  { name: 'AODA', flag: 'ca', href: undefined },
] as const;

const regions = [
  {
    id: 'us',
    flag: 'us',
    label: 'United States',
    title: 'ADA and Section 508',
    body: [
      'The Department of Justice final rule under ADA Title II sets WCAG 2.1 Level AA as the technical standard for state and local government websites and mobile apps.',
      'For private businesses under Title III, courts and settlements consistently reference WCAG 2.1 AA, and increasingly WCAG 2.2 AA. Federal agencies and their vendors follow Section 508, which incorporates WCAG 2.0 AA.',
    ],
    link: { href: '/blog/ada-website-compliance-guide', label: 'Read the ADA compliance guide' },
    dates: [
      { d: 'April 26, 2027', t: 'Title II compliance date for public entities serving 50,000 or more people (extended by one year in April 2026)' },
      { d: 'April 26, 2028', t: 'Title II compliance date for smaller entities and special districts' },
      { d: 'January 18, 2018', t: 'Revised Section 508 standards take effect' },
    ],
  },
  {
    id: 'eu',
    flag: 'eu',
    label: 'European Union',
    title: 'European Accessibility Act and EN 301 549',
    body: [
      'The European Accessibility Act applies to many consumer-facing products and services, including e-commerce, banking, transport and e-books. Conformance is measured against the harmonized standard EN 301 549, which incorporates WCAG 2.1 AA for web content.',
      'The Web Accessibility Directive already requires public sector websites and apps in member states to meet the same standard.',
    ],
    link: { href: '/blog/wcag-2-2-checklist', label: 'Work through the WCAG 2.2 checklist' },
    dates: [
      { d: 'June 28, 2025', t: 'European Accessibility Act requirements apply' },
      { d: 'June 23, 2021', t: 'Web Accessibility Directive applies to public sector mobile apps' },
    ],
  },
  {
    id: 'uk',
    flag: 'gb',
    label: 'United Kingdom',
    title: 'Equality Act and Public Sector Regulations',
    body: [
      'The Equality Act 2010 requires service providers to make reasonable adjustments for disabled people, which includes digital services.',
      'Public sector bodies must meet WCAG 2.2 AA under the Public Sector Bodies Accessibility Regulations 2018 and publish an accessibility statement.',
    ],
    link: { href: '/blog/wcag-2-2-checklist', label: 'See what changed in WCAG 2.2' },
    dates: [
      { d: 'October 2024', t: 'Government monitoring moves to WCAG 2.2 AA' },
      { d: 'September 23, 2018', t: 'Public Sector Bodies Accessibility Regulations in force' },
    ],
  },
  {
    id: 'ca',
    flag: 'ca',
    label: 'Canada',
    title: 'AODA and the Accessible Canada Act',
    body: [
      'In Ontario, the Accessibility for Ontarians with Disabilities Act requires designated public sector organizations and businesses with 50 or more employees to meet WCAG 2.0 Level AA for public websites.',
      'Federally regulated organizations are subject to the Accessible Canada Act, with standards developed by Accessibility Standards Canada.',
    ],
    link: { href: '/blog/what-is-a-website-accessibility-checker', label: 'How accessibility checkers work' },
    dates: [
      { d: 'January 1, 2021', t: 'AODA WCAG 2.0 AA requirement for public websites in effect' },
      { d: 'July 11, 2019', t: 'Accessible Canada Act in force' },
    ],
  },
];

// "What a WCAG check actually tests": the four POUR principles.
const pour = [
  {
    name: 'Perceivable',
    question: 'Can people see, hear or otherwise take in the content?',
    auto: [['Images without alternative text', '1.1.1'], ['Text with too little contrast', '1.4.3'], ['Pinch zoom turned off', '1.4.4']],
    person: [['Whether alt text is meaningful', '1.1.1'], ['Accurate video captions', '1.2.2'], ['Meaning shown by color alone', '1.4.1']],
  },
  {
    name: 'Operable',
    question: 'Can people use the page with a keyboard, a screen reader or a touch screen?',
    auto: [['Links with no name', '2.4.4'], ['No way to skip repeated content', '2.4.1'], ['Tap targets under 24px, new in WCAG 2.2', '2.5.8']],
    person: [['Keyboard traps', '2.1.2'], ['Visible focus indicator', '2.4.7'], ['Logical focus order', '2.4.3']],
  },
  {
    name: 'Understandable',
    question: 'Is the page predictable and the content clear?',
    auto: [['Missing page language', '3.1.1'], ['Invalid language codes', '3.1.1'], ['Foreign-language passages marked with invalid codes', '3.1.2']],
    person: [['Unexpected changes on focus', '3.2.1'], ['Helpful error messages', '3.3.3'], ['Help in the same place on every page', '3.2.6']],
  },
  {
    name: 'Robust',
    question: 'Will it work with assistive technology, today and tomorrow?',
    auto: [['Form fields without labels', '4.1.2'], ['Buttons with no name', '4.1.2'], ['Invalid or misused ARIA', '4.1.2']],
    person: [['Status messages that are announced', '4.1.3'], ['Custom widgets that behave as expected', '4.1.2']],
  },
];

// WCAG version comparison. Counts come from server/wcag-criteria.js.
const wcagVersions = [
  { id: 'v20', name: 'WCAG 2.0' },
  { id: 'v21', name: 'WCAG 2.1' },
  { id: 'v22', name: 'WCAG 2.2', current: true },
];
const wcagRows: { label: string; flag?: 'us' | 'eu' | 'gb' | 'ca'; cells: string[] }[] = [
  { label: 'Published', cells: ['December 2008', 'June 2018', 'October 2023'] },
  { label: 'Success criteria', cells: ['61', '78 (17 new)', '86 (9 new, 4.1.1 Parsing removed)'] },
  { label: 'Level A and AA criteria', cells: ['38', '50', '55'] },
  {
    label: 'What it added',
    cells: [
      'The foundation: four principles (perceivable, operable, understandable, robust) and three conformance levels',
      'Mobile, low vision and cognitive needs: reflow, orientation, text spacing, non-text contrast and status messages',
      'Focus not obscured, dragging alternatives, 24px minimum targets, consistent help, redundant entry and accessible sign-in',
    ],
  },
  {
    label: 'United States',
    flag: 'us',
    cells: [
      'Section 508 standard for federal agencies and vendors',
      'DOJ Title II rule for state and local government; the usual benchmark in ADA Title III cases',
      'Not required yet; the safest target because it also covers 2.1 and 2.0',
    ],
  },
  {
    label: 'European Union (EAA)',
    flag: 'eu',
    cells: ['Not enough on its own', 'Required through EN 301 549', 'Expected in the next EN 301 549 revision'],
  },
  {
    label: 'United Kingdom public sector',
    flag: 'gb',
    cells: ['Not enough on its own', 'Previous benchmark', 'Monitored against since October 2024'],
  },
  {
    label: 'Ontario, Canada (AODA)',
    flag: 'ca',
    cells: ['Required for public websites', 'Exceeds the requirement', 'Exceeds the requirement'],
  },
  { label: 'In AccessBell', cells: ['Available', 'Available, plus ADA and EN 301 549 presets', 'Default (Level AA)'] },
];

const faqs: FaqItem[] = [
  {
    q: 'What is a website accessibility checker?',
    a: 'A website accessibility checker is a tool that scans the code of a web page and flags barriers for people with disabilities, such as missing alt text, unlabeled form fields and missing page language. AccessBell maps every finding to the relevant WCAG success criterion and explains how to fix it.',
  },
  {
    q: 'Is the AccessBell accessibility checker free?',
    a: 'Yes. You can scan any public page for free with no account and see how many issues it has and how severe they are. To see each issue and its fix, subscribe to Pro. The Pro plan, $29 per domain per month or $199 per domain per year, adds domain crawling, continuous monitoring, AI-assisted fixes, reports and team features.',
  },
  {
    q: 'Which accessibility standards does AccessBell check?',
    a: 'Scans are based on WCAG 2.2 success criteria at Levels A and AA. Because WCAG is the technical benchmark behind the ADA, Section 508, EN 301 549, AODA and the European Accessibility Act, results are relevant to each of them.',
  },
  {
    q: 'Can an automated checker make my website fully compliant?',
    a: 'No automated tool can guarantee compliance. Automated rules reliably catch objective, code-level failures, but some requirements, such as whether alt text is meaningful or focus order is logical, need human review. Read our guide to <a href="/blog/automated-vs-manual-accessibility-testing">automated vs manual accessibility testing</a>.',
  },
  {
    q: 'Does AccessBell use an accessibility overlay?',
    a: 'No. AccessBell does not inject a widget into your site. It finds issues in your source code and helps your team fix them properly, so the improvements are permanent.',
  },
  {
    q: 'How does AccessBell fit into a development and QA workflow?',
    a: 'Use the free scanner to check any public page on demand. With AccessBell Pro, scan staging before release, using custom HTTP headers to get past authentication, and production after each deploy. Each issue includes the failing HTML and the WCAG criterion, so it can go straight into a ticket, and the CSV export drops into your test tracker. Monitored pages are rescanned daily, and owners and admins are emailed when a new critical or serious issue appears.',
  },
  {
    q: 'How often should I scan my website for accessibility issues?',
    a: 'Scan at least weekly and after every major release. Websites change constantly, and new content is the most common source of regressions. The Pro plan monitors your pages continuously and includes unlimited rescans.',
  },
];
const challenges = [
  {
    icon: 'scale',
    title: 'Knowing which standard applies',
    problem: 'The ADA does not name a technical standard for private businesses. Courts and settlements usually point to WCAG 2.1 Level AA, government rules use WCAG 2.1 or 2.0, and WCAG 2.2 is the newest version.',
    fix: 'Choose WCAG 2.2, 2.1 or 2.0 at Level A, AA or AAA, or a preset for the ADA, Section 508 or EN 301 549. <a href="/blog/ada-website-compliance-guide">ADA website compliance guide</a>',
  },
  {
    icon: 'refresh',
    title: 'Websites never stop changing',
    problem: 'New products, blog posts, plugins and redesigns add new barriers after you fix the old ones. A one-time audit is out of date the next time someone edits the site.',
    fix: 'Scheduled scans of up to 500 pages per domain, with email alerts when something new fails.',
  },
  {
    icon: 'eye',
    title: 'Automated tools cannot test everything',
    problem: 'Software can find missing alt text or low contrast, but a person has to judge whether alt text is accurate or a page makes sense with a screen reader.',
    fix: 'Clear labels for what was tested automatically and step-by-step procedures for what needs a person. <a href="/blog/automated-vs-manual-accessibility-testing">Automated vs manual testing</a>',
  },
  {
    icon: 'code',
    title: 'Knowing how to fix each issue',
    problem: 'WCAG is written for specialists. Small teams often know something is wrong but not which line of code to change, and developer time is limited.',
    fix: 'The failing HTML and a corrected example for every issue, grouped by shared template so one fix clears many pages. AccessBellFix can apply approved fixes right away.',
  },
  {
    icon: 'layers',
    title: 'Overlays that promise instant compliance',
    problem: 'Widgets that claim to make a site compliant overnight do not change your code. In 2025 the FTC ordered one overlay vendor to pay $1 million over those claims.',
    fix: 'AccessBell finds the barriers in your code so they are fixed at the source. <a href="/comparisons/accessibe-vs-accessbell">Why overlays fall short</a>',
  },
  {
    icon: 'doc',
    title: 'PDFs and documents',
    problem: 'Menus, forms and policies shared as PDFs have to be accessible too, and many are exported without tags, a title or a language.',
    fix: 'Finds the PDFs linked from your pages, checks each one and fixes the title and language. <a href="/resources/pdf-accessibility-checker">Free PDF checker</a>',
  },
  {
    icon: 'shield',
    title: 'Proving good faith',
    problem: 'If a demand letter arrives, you need to show what you tested, what you fixed and when. Most teams have no record.',
    fix: 'The Compliance Vault keeps dated scan records, a fix log and exportable evidence packages. <a href="/resources/help-center/scans-and-reports/compliance-vault">How the Compliance Vault works</a>',
  },
  {
    icon: 'card',
    title: 'Cost for small businesses',
    problem: 'Expert audits and enterprise platforms are often quoted in the thousands of dollars, and overlay pricing can rise with your traffic.',
    fix: 'A flat $29 per domain per month, or $199 per year, with every feature included. <a href="/pricing">See pricing</a>',
  },
];

---
<BaseLayout
  title="Website Accessibility Checker - Free WCAG Scan | AccessBell"
  description="Free website accessibility checker. Scan any page against WCAG 2.2, ADA and Section 508 to see how many issues it has, then get code-level fixes with Pro."
  schema={[softwareSchema(), faqSchema(faqs)]}
>
  <section class="hero hero-split" id="scan" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span class="h1-kicker">Website Accessibility Checker</span>
          Find ADA Issues on Your Online Store <span class="accent">Before They Cost You a Lawsuit</span>
        </h1>
        <p class="lead">
          Built for <a href="/industries/ecommerce">e-commerce store owners</a>. AccessBell scans your product pages, cart and checkout against WCAG 2.2, flags the barriers named in ADA website lawsuits, such as missing alt text, unlabeled checkout fields and unnamed buttons, shows the exact fix, and rescans on a schedule so new issues are caught early. Run a free scan to see how many issues your store has.
        </p>
        <ScanForm id="hero" />
        <DemoVideo class="demo-cta-hero" />
        <div class="compliance-row">
          <span id="compliance-label">Tests your site against:</span>
          <ul aria-labelledby="compliance-label">
            {compliance.map((s) => <li><Flag code={s.flag} eager />{s.href ? <a href={s.href}>{s.name}</a> : s.name}</li>)}
          </ul>
        </div>
      </div>
      <HeroDemo />
    </div>
  </section>

  <section class="results" id="scan-results" aria-live="polite" aria-busy="false" hidden>
    <div class="container" data-results></div>
  </section>

  <section class="standards-strip" aria-labelledby="std-strip">
    <div class="container">
      <p id="std-strip">Checks aligned with global accessibility standards</p>
      <ul class="standards-list">
        {standards.map((s) => <li><Flag code={s.flag} />{s.href ? <a href={s.href}>{s.name}</a> : s.name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-tight lawsuit-stats" aria-labelledby="stats2025-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">ADA website lawsuits in 2025</span>
        <h2 id="stats2025-title">How Many Businesses Were Sued Over <span class="accent">Website Accessibility in 2025?</span></h2>
        <p>Website accessibility lawsuits rose again in 2025, and most targeted small and mid-sized businesses. New York (1,021) and Florida (961) federal courts saw the most filings.</p>
      </div>
      <ul class="stat-grid">
        {LAWSUIT_STATS.map((s) => (
          <li class="stat-card">
            <strong>{s.value}</strong>
            <span>{s.text}</span>
            <a href={s.source.url} rel="noopener" target="_blank">{s.source.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
          </li>
        ))}
      </ul>
      <p class="stat-foot">
        Figures count lawsuits, not unique companies. See <a href="/blog/what-happens-after-being-sued-for-ada-website-compliance">what happens after being sued for ADA website compliance</a> and <a href="/pricing#suits-title">what real cases cost</a>.
      </p>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="challenges-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why compliance is hard</span>
        <h2 id="challenges-title">Common Challenges With ADA Compliance, WCAG and <span class="accent">Accessibility Compliance</span></h2>
        <p>Keeping a website accessible is hard, even for businesses that care about it. These are the problems teams run into most often, and how AccessBell helps with each one.</p>
      </div>
      <ul class="challenge-grid">
        {challenges.map((c) => (
          <li class="challenge-card">
            <span class="challenge-icon"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p>{c.problem}</p>
            <p class="challenge-fix"><strong>How AccessBell helps:</strong> <Fragment set:html={c.fix} /></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="legal-title">
    <div class="container grid-2">
      <div class="feature-copy">
        <span class="eyebrow">Reduce legal risk</span>
        <h2 id="legal-title">Find and Fix Accessibility Issues <span class="accent">Before They Become Legal Problems</span></h2>
        <p class="lead">
          Most accessibility claims start with barriers a scan can find in seconds: missing alt text, unlabeled form fields and buttons with no name. AccessBell surfaces them first, ranked by impact.
        </p>
        <ul class="check-list">
          <li><Icon name="check" />Every issue mapped to its WCAG 2.2 success criterion</li>
          <li><Icon name="check" />Severity ranking so you fix what blocks users first</li>
          <li><Icon name="check" />The failing HTML for every issue, ready to paste into a ticket</li>
        </ul>
        <a class="btn" href="/#scan">Scan your site now <Icon name="arrow" /></a>
      </div>
      <div class="mock" role="img" aria-label="Illustration of an AccessBell scan report showing a score of 72 and three issues ranked by severity">
        <div class="mock-bar" aria-hidden="true"><i></i><i></i><i></i><span>accessbell.co/report</span></div>
        <div class="mock-body" aria-hidden="true">
          <div class="mock-score">
            <div class="score-ring pct-72"><span>72</span></div>
            <div><strong>Needs attention</strong><p>14 issues across 6 WCAG criteria</p></div>
          </div>
          <div class="mock-row"><span><span class="dot dot-red"></span><strong>Form field has no label</strong></span><span class="tag tag-critical">1.3.1</span></div>
          <div class="mock-row"><span><span class="dot dot-red"></span><strong>Image missing alt text</strong></span><span class="tag tag-serious">1.1.1</span></div>
          <div class="mock-row"><span><span class="dot dot-amber"></span><strong>Heading level skipped</strong></span><span class="tag tag-moderate">1.3.1</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="eval-title">
    <div class="container">
      <div class="section-head eval-head">
        <span class="eyebrow">Thorough by design</span>
        <h2 id="eval-title">Web Accessibility <span class="accent">Evaluation Tool</span></h2>
        <p>
          AccessBell is a thorough web accessibility evaluation tool, not a quick surface check. Every page loads in a real Chrome browser and is tested with the open-source <a href="https://github.com/dequelabs/axe-core" rel="noopener noreferrer">axe-core</a> rules after your JavaScript has run, so the results reflect what visitors actually get. Each failure is mapped to the exact <a href="https://www.w3.org/TR/WCAG22/" rel="noopener noreferrer">WCAG 2.2</a> success criterion it breaks, with the failing HTML and a fix.
        </p>
        <p>
          Where automation cannot decide, such as whether alt text is meaningful, AccessBell flags the item for manual review instead of guessing. That follows the W3C's guidance in <a href="https://www.w3.org/WAI/test-evaluate/" rel="noopener noreferrer">Evaluating Web Accessibility</a>: tools find many issues fast, and people confirm the rest. <a href="/methodology">See exactly how we test</a>.
        </p>
      </div>
      <figure class="app-shot">
        <img src="/images/dashboard/domain-report.webp" width="1600" height="825" loading="lazy" decoding="async" alt="The AccessBell domain report for example.com. It shows a score of 63 out of 100 and the status Not conformant against WCAG 2.2 Level AA, 132 active issues, 4 issues solved since the last scan, 12 of 12 pages scanned and 60 items for manual review, next to a scan history chart of score, open issues and pages scanned." />
        <figcaption>The domain report in the AccessBell dashboard, shown with sample data.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="reaudit-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">One scan, every standard</span>
        <h2 id="reaudit-title">Re-Audit Your Domains Against Every Accessibility Standard, <span class="accent">Worldwide</span></h2>
        <p>WCAG is the technical foundation of accessibility law around the world. AccessBell checks against it once and reports in the language each regulation uses.</p>
      </div>
      <ul class="badge-row" role="list">
        {standards.map((s) => (
          <li class="std-badge">
            <span class="seal"><Icon name="shield" /><span class="seal-flag"><Flag code={s.flag} /></span></span>
            <strong>{s.href ? <a href={s.href}>{s.name}</a> : s.name}</strong>
            <span>{s.sub}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="pour-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Beyond a single score</span>
        <h2 id="pour-title">What a WCAG Check Actually Tests</h2>
        <p>WCAG 2.2 organizes its success criteria under four principles: <strong>Perceivable, Operable, Understandable and Robust</strong> (POUR). A real WCAG check reports against each one, and is clear about what a person still needs to test. A generic accessibility score is not. See our full <a href="/methodology">testing methodology</a> for the engine and rules behind every scan.</p>
      </div>
      <ul class="pour-grid">
        {pour.map((p) => (
          <li class="pour-card">
            <h3>{p.name}</h3>
            <p class="pour-q">{p.question}</p>
            <p class="pour-label"><Icon name="scan" /> Automated check flags</p>
            <ul class="pour-list">
              {p.auto.map(([t, sc]) => <li>{t} <span class="pour-sc">({sc})</span></li>)}
            </ul>
            <p class="pour-label pour-label-person"><Icon name="eye" /> Needs a person</p>
            <ul class="pour-list pour-list-person">
              {p.person.map(([t, sc]) => <li>{t} <span class="pour-sc">({sc})</span></li>)}
            </ul>
          </li>
        ))}
      </ul>
      <p class="pour-note">Every issue in an AccessBell report links to the exact success criterion it fails, its conformance level (A, AA or AAA) and a severity rank. Items only a person can judge are listed separately for manual review.</p>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="roles-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Built for your role</span>
        <h2 id="roles-title">One Report, <span class="accent">Three Ways to Use It</span></h2>
        <p>Accessibility is a team sport. AccessBell gives each person the detail they need, in the language they work in.</p>
      </div>
      <div class="grid-3 roles">
        <article class="card">
          <div class="icon-tile"><Icon name="code" /></div>
          <h3>For Web Developers</h3>
          <p>Failing markup, not vague warnings. Pages render in headless Chromium and run through axe-core, so what you see is the real DOM after your JavaScript runs.</p>
          <ul class="check-list">
            <li><Icon name="check" />The offending HTML snippet for every failing element</li>
            <li><Icon name="check" />Correct-markup examples you can copy</li>
            <li><Icon name="check" />Component grouping: fix the shared template once</li>
            <li><Icon name="check" />Scan staging behind auth with custom HTTP headers</li>
          </ul>
          <a class="link-arrow" href="/resources/help-center/fixing-issues/read-an-issue">How to read an issue <Icon name="arrow" /></a>
        </article>
        <article class="card">
          <div class="icon-tile"><Icon name="check-circle" /></div>
          <h3>For QA Testers</h3>
          <p>Repeatable accessibility tests you can sign off. Pin each domain to a WCAG version and level, and every run is tested the same way.</p>
          <ul class="check-list">
            <li><Icon name="check" />Pass and fail by success criterion, with a coverage table</li>
            <li><Icon name="check" />Desktop and mobile viewports in the same run</li>
            <li><Icon name="check" />Daily regression scans with alerts on new serious issues</li>
            <li><Icon name="check" />CSV export for your test tracker, plus a manual checklist</li>
          </ul>
          <a class="link-arrow" href="/blog/wcag-2-aa-checklist">Get the WCAG 2 AA checklist <Icon name="arrow" /></a>
        </article>
        <article class="card">
          <div class="icon-tile"><Icon name="doc" /></div>
          <h3>For Content Creators</h3>
          <p>Publish without breaking accessibility. Rescan a page after every update and catch the problems content edits introduce most.</p>
          <ul class="check-list">
            <li><Icon name="check" />Images published without alt text</li>
            <li><Icon name="check" />Empty headings and links with no text</li>
            <li><Icon name="check" />Text colors with too little contrast</li>
            <li><Icon name="check" />Plain-language fixes, no code knowledge needed</li>
          </ul>
          <a class="link-arrow" href="/resources/help-center/fixing-issues/fix-common-errors">Fix the most common errors <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-ink" aria-labelledby="versions-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Which version applies</span>
        <h2 id="versions-title">WCAG 2.0 vs 2.1 vs 2.2</h2>
        <p>Most US accessibility lawsuits and settlements cite WCAG 2.1 AA today. The UK public sector already monitors against WCAG 2.2, and it is the version the next rules are expected to adopt. AccessBell checks WCAG 2.2 AA by default and lets you switch to 2.1 or 2.0 for legacy reports.</p>
      </div>
      <p class="versions-hint" aria-hidden="true">Scroll sideways to compare all three versions.</p>
      <div class="versions-wrap" role="region" aria-label="Table: WCAG 2.0, 2.1 and 2.2 compared" tabindex="0">
        <table class="versions">
          <caption class="visually-hidden">Comparison of WCAG 2.0, 2.1 and 2.2: release dates, criteria counts, what each added and where each is required</caption>
          <thead>
            <tr>
              <td></td>
              {wcagVersions.map((v) => (
                <th scope="col" id={v.id} class:list={{ current: v.current }}>
                  {v.name}{v.current && <span class="versions-tag">Current</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {wcagRows.map((row) => (
              <tr>
                <th scope="row">
                  <span class="versions-label">{row.flag && <Flag code={row.flag} />}{row.label}</span>
                </th>
                {row.cells.map((c, i) => <td class:list={{ current: wcagVersions[i].current }}>{c}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="versions-note">Each version includes everything in the one before it, except 4.1.1 Parsing, which WCAG 2.2 retired. Content that meets WCAG 2.2 AA also meets 2.1 AA and 2.0 AA. Test a page with our free <a href="/resources/wcag-2-2-aa-checker">WCAG 2.2 AA checker</a> or <a href="/resources/wcag-2-1-aa-checker">WCAG 2.1 AA checker</a>, or work through the <a href="/blog/wcag-2-aa-checklist">WCAG 2 AA checklist</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="laws-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Legislation tracker</span>
        <h2 id="laws-title">Latest Updates on Global Accessibility Legislation and Standards</h2>
        <p>Key requirements and dates for the regions where most of our customers operate.</p>
      </div>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label="Regions">
          {regions.map((r, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${r.id}`}
              aria-controls={`panel-${r.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? '0' : '-1'}
            >
              <Flag code={r.flag} />{r.label}
            </button>
          ))}
        </div>
        {regions.map((r, i) => (
          <div class="tabpanel" role="tabpanel" id={`panel-${r.id}`} aria-labelledby={`tab-${r.id}`} tabindex="0" hidden={i !== 0}>
            <div>
              <h3>{r.title}</h3>
              {r.body.map((p) => <p>{p}</p>)}
              <a class="link-arrow" href={r.link.href}>{r.link.label} <Icon name="arrow" /></a>
            </div>
            <div class="keydates">
              <h4>Key Dates</h4>
              <dl>
                {r.dates.map((d) => (
                  <div><dt>{d.d}</dt><dd>{d.t}</dd></div>
                ))}
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="blog-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">From the blog</span>
        <h2 id="blog-title">Guidance on Digital Accessibility and Compliance</h2>
        <p>Practical articles on WCAG, the ADA and building accessible websites that stay that way.</p>
      </div>
      <div class="post-grid post-grid-3">
        {posts.map((post) => (
          <article class="post-card">
            {coverFor(post.id)
              ? <img class="post-card-img" src={coverFor(post.id)!.src} width="1200" height="630" alt="" loading="lazy" decoding="async" />
              : <div class="post-cover" aria-hidden="true"><span>{post.data.category}</span></div>}
            <div class="post-card-body">
              <h3><a href={postPath(post)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime(post.body ?? '')} min read</span>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="center more-link"><a class="btn btn-outline" href="/blog">View all articles <Icon name="arrow" /></a> <a class="btn btn-outline" href="/resources">Free tools and guides <Icon name="arrow" /></a></p>
    </div>
  </section>

