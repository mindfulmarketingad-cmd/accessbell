---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found | AccessBell" description="The page you are looking for does not exist or has moved." noindex>
  <section class="notfound" aria-labelledby="nf-title">
    <div class="container container-narrow">
      <p class="code" aria-hidden="true">404</p>
      <h1 id="nf-title">We could not find that page</h1>
      <p class="lead">The link may be broken or the page may have moved. Try one of these instead.</p>
      <div class="cta-actions">
        <a class="btn" href="/">Go to the homepage <Icon name="arrow" /></a>
        <a class="btn btn-outline" href="/blog">Read the blog</a>
        <a class="btn btn-outline" href="/sitemap">View sitemap</a>
      </div>
    </div>
  </section>
</BaseLayout>
