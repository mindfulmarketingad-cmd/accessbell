---
import { getEntry } from 'astro:content';
import { postPath } from '../../../lib/posts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ScanForm from '../../../components/ScanForm.astro';
import Faq from '../../../components/Faq.astro';
import CtaBand from '../../../components/CtaBand.astro';
import AuthorAvatar from '../../../components/AuthorAvatar.astro';
import PlatformLogo from '../../../components/PlatformLogo.astro';
import PlatformSiblings from '../../../components/PlatformSiblings.astro';
import { SITE } from '../../../config/site';
import { authorPath, authorSchema } from '../../../lib/authors';
import { faqSchema } from '../../../lib/schema';
import { formatDate } from '../../../lib/format';
import { PLATFORMS, platformPath, platformAdaPath, platformHome, platformId, type Platform } from '../../../data/platforms';
import { coverageFor } from '../../../lib/checker-coverage';

export function getStaticPaths() {
  return PLATFORMS.map((p) => ({ params: { platform: platformId(p) }, props: { p } }));
}

const { p } = Astro.props as { p: Platform };
const REVIEWED = new Date('2026-09-28');
const url = `${SITE.url}${platformPath(p)}`;
const author = await getEntry('authors', 'joseph-edwards');
const isHost = p.kind === 'host';
// Every other platform checker, grouped by type with this platform's own type first.
const GROUP_ORDER = ['ecommerce', 'cms', 'builder', 'framework', 'host'] as const;
const GROUP_HEADING = { ecommerce: 'E-commerce platforms', cms: 'Content management systems', builder: 'Website and page builders', framework: 'Frameworks and developer platforms', host: 'Web hosts' } as const;
const otherGroups = [p.group, ...GROUP_ORDER.filter((g) => g !== p.group)]
  .map((g) => ({ id: g, heading: GROUP_HEADING[g], items: PLATFORMS.filter((o) => o.group === g && o.slug !== p.slug) }))
  .filter((g) => g.items.length);
const cov = coverageFor('2.2');
const related = (await Promise.all(p.related.map((id) => getEntry('blog', id)))).filter(Boolean);

const schema = [
  {
    '@type': 'WebApplication',
    '@id': `${url}#app`,
    name: `${p.name} Accessibility Checker`,
    url,
    description: p.description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: `Free ${p.name} Accessibility Checker`,
    description: p.description,
    dateModified: REVIEWED.toISOString(),
    author: author ? { '@id': `${SITE.url}${authorPath(author)}#author` } : { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntityOfPage: { '@id': `${url}#webpage` },
  },
  ...(author ? [authorSchema(author)] : []),
  faqSchema(p.faqs),
];
---
<BaseLayout
  title={`${p.seoTitle} | AccessBell`}
  description={p.description}
  breadcrumbs={[{ label: 'Platforms', href: '/platforms' }, { label: p.name, href: platformHome(p) }, { label: `${p.name} Accessibility Checker`, href: platformPath(p) }]}
  schema={schema}
>
  <section class="checker-hero" id="scan" aria-labelledby="platform-title">
    <div class="container">
      <div class="checker-logo"><PlatformLogo slug={p.slug} name={p.name} size="lg" /></div>
      <h1 id="platform-title">{p.name} Accessibility Checker</h1>
      <p class="lead">{p.lead}</p>
      <ScanForm id="platform" buttonLabel={`Check My ${p.name} Site`} />
      <p class="checker-meta">
        <Icon name="check" /> Real Chrome browser scan, powered by axe-core
        <span aria-hidden="true">&middot;</span> Free, no account needed
      </p>
      <p class="checker-seeall"><a href={platformHome(p)}>All {p.name} checkers</a> <span aria-hidden="true">&middot;</span> <a href="/platforms">All platforms</a></p>
    </div>
  </section>

  <section class="results" id="scan-results" aria-live="polite" aria-busy="false" hidden>
    <div class="container" data-results></div>
  </section>

  <article class="container checker-body">
    <div class="checker-byline">
      {author && <a class="byline-person" href={authorPath(author)}><AuthorAvatar name={author.data.name} /><span><strong>{author.data.name}</strong><small>Author</small></span></a>}
      <span>Reviewed <time datetime={REVIEWED.toISOString()}>{formatDate(REVIEWED)}</time></span>
    </div>

    <section aria-labelledby="what-is">
      <h2 id="what-is">Accessibility on {p.name}</h2>
      {p.whatIs.map((para) => <p>{para}</p>)}
      <p><a href={p.stat.href} rel="noopener noreferrer" target="_blank">{p.stat.text}<span class="visually-hidden"> (opens in a new tab, source: {p.stat.label})</span></a></p>
    </section>

    <section aria-labelledby="common-issues">
      <h2 id="common-issues">Common Accessibility Issues on {p.name} Sites</h2>
      <ul class="focus-grid">
        {p.commonIssues.map((i) => <li><h3>{i.title}</h3><p>{i.text}</p></li>)}
      </ul>
    </section>

    <section aria-labelledby="how-scans">
      <h2 id="how-scans">How AccessBell Scans Your {p.name} Site</h2>
      <ol class="steps-list">
        <li><strong>Enter any public page.</strong> Paste the address of a page on your {p.name} site into the scanner above. There is nothing to install{isHost ? ' on your hosting account' : ''}: no plugin, no code snippet and no login.</li>
        <li><strong>We load it in a real browser.</strong> AccessBell opens the page in headless Chrome and runs its scripts, so it tests what your visitors actually see, including content added by your {isHost ? 'theme, builder or plugins' : 'theme, apps or plugins'}.</li>
        <li><strong>We run the WCAG rules.</strong> The open-source <a href="https://github.com/dequelabs/axe-core" rel="noopener noreferrer">axe-core</a> engine checks the page against the standard you choose, and every result is mapped to the WCAG success criteria it affects.</li>
        <li><strong>You see what is wrong in seconds.</strong> The free scan lists every issue it finds, ranked by severity, with the WCAG criteria each one fails. Start a free trial to get the failing code and the fix for each one. Our <a href="/methodology">methodology</a> explains exactly what runs and what still needs a person.</li>
      </ol>
    </section>

    <section aria-labelledby="included">
      <h2 id="included">What You Get From the Free Scan and the Free Trial</h2>
      <h3>Free, with no account</h3>
      <ul class="check-list">
        <li><Icon name="check" /><span>{cov.ruleCount} automated rules for WCAG 2.2 Level AA, or presets for WCAG 2.1 AA, the ADA, Section 508 and EN 301 549</span></li>
        <li><Icon name="check" /><span>Every issue found on the page, ranked by severity from critical to minor</span></li>
        <li><Icon name="check" /><span>The WCAG success criteria each issue fails, which you can look up in our <a href="/resources/wcag">WCAG library</a></span></li>
      </ul>
      <h3>With a 3-day free trial</h3>
      <ul class="check-list">
        <li><Icon name="check" /><span>The failing HTML, so you can find the element in your {isHost ? 'site' : p.name} editor or code</span></li>
        <li><Icon name="check" /><span>How to fix each issue, with a corrected example</span></li>
        <li><Icon name="check" /><span>Every page scanned, up to 500 per domain, with daily monitoring and an email when something breaks</span></li>
        <li><Icon name="check" /><span>A list of checks that need a person to review, so nothing is missed</span></li>
        <li><Icon name="check" /><span>A dated record of your scans and fixes</span></li>
      </ul>
      <p><a class="btn btn-accent" href="/app/signup">Start 3-day free trial</a></p>
    </section>

    <section aria-labelledby="fixing">
      <h2 id="fixing">How to Fix What the Scan Finds</h2>
      <ol class="steps-list">
        {p.fixNotes.map((n) => <li>{n}</li>)}
        <li>Run a free scan above on your homepage and a few key pages, fix issues starting with critical and serious, then rescan to confirm.</li>
        <li>For ongoing protection, <a href="/pricing">AccessBell Pro</a> monitors up to 500 URLs per domain every day and alerts you when a theme, app or plugin update introduces a new issue.</li>
      </ol>
    </section>

    <section aria-labelledby="related-guides">
      <h2 id="related-guides">Related Guides</h2>
      <ul class="related-guides">
        {related.map((post) => post && (
          <li><a href={postPath(post)}>{post.data.title}</a><span>{post.data.description}</span></li>
        ))}
        <li><a href="/resources/wcag">WCAG Success Criteria Library</a><span>Look up any success criterion the scan flags, in plain language.</span></li>
        <li><a href={platformAdaPath(p)}>{p.name} ADA Compliance Checker</a><span>The same scan with the ADA preset, plus the ADA risks specific to {p.name} sites.</span></li>
        <li><a href="/tools/statement-generator">Free Accessibility Statement Generator</a><span>Publish a statement once your {p.name} site's known issues are fixed.</span></li>
      </ul>
    </section>

    <section aria-labelledby="faq-title">
      <h2 id="faq-title">{p.name} Accessibility — Frequently Asked Questions</h2>
      <Faq items={p.faqs} />
    </section>

    <section aria-labelledby="sources" class="checker-sources">
      <h2 id="sources">Sources</h2>
      <ul>
        <li><a href={p.stat.href} rel="noopener noreferrer" target="_blank">{p.stat.label}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      </ul>
      <p class="muted">This page explains general accessibility patterns for {p.name} sites and is not legal advice. AccessBell is not affiliated with {p.name}. {p.name} and its logo are trademarks of their owners and are used only to identify the platform. See our <a href="/disclaimer">disclaimer</a>.</p>
    </section>
  </article>

  <PlatformSiblings p={p} current="accessibility-checker" />

  <section class="section section-surface" aria-labelledby="more-platforms">
    <div class="container">
      <div class="section-head">
        <h2 id="more-platforms">Accessibility Checkers for Other Platforms</h2>
        <p>The same free scanner, framed for the platform you use. Browse <a href="/platforms">all {PLATFORMS.length} platforms</a>.</p>
      </div>
      {otherGroups.map((g) => (
        <div class="platform-links-group">
          <h3>{g.heading}</h3>
          <ul class="platform-links">
            {g.items.map((o) => (
              <li>
                <a href={platformPath(o)}>
                  <PlatformLogo slug={o.slug} name={o.name} size="sm" />
                  <span>{o.name} Accessibility Checker</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="more-link"><a class="link-arrow" href="/platforms">All platforms <Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
<script>
  import '../../../scripts/free-scan.js';
</script>
