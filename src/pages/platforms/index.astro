---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ScanForm from '../../components/ScanForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import PlatformLogo from '../../components/PlatformLogo.astro';
import { SITE } from '../../config/site';
import { PLATFORMS, platformPath } from '../../data/platforms';
import { CHECKERS, checkerPath } from '../../data/checkers';
import { INDUSTRIES, industryPath } from '../../data/industries';
import { STATE_LAWS, stateLawPath } from '../../data/state-laws';

const PATH = '/platforms';
const GROUPS = [
  { id: 'ecommerce', optgroup: 'E-commerce platforms', heading: 'Accessibility Checkers for E-commerce Platforms', intro: 'Product pages, carts and checkouts are where an accessibility barrier costs a sale. Pick your store platform.', label: 'E-commerce platform' },
  { id: 'cms', optgroup: 'Content management systems', heading: 'Accessibility Checkers for Content Management Systems', intro: 'Themes, modules, editors and plugins decide what a CMS site outputs. Each checker covers the ones that matter on that CMS.', label: 'CMS' },
  { id: 'builder', optgroup: 'Website builders', heading: 'Accessibility Checkers for Website Builders', intro: 'Drag-and-drop builders put the layout in your hands. These checkers show what to set in each editor.', label: 'Website builder' },
  { id: 'host', optgroup: 'Web hosts', heading: 'Accessibility Checkers for Web Hosts', intro: 'Hosted with one of these providers? Scan your site and see the issues most common on the kinds of sites they host.', label: 'Web host' },
] as const;
const url = `${SITE.url}${PATH}`;
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    name: 'Accessibility Checkers by Platform',
    url,
    isPartOf: { '@id': `${SITE.url}/#website` },
    hasPart: PLATFORMS.map((p) => ({ '@type': 'WebPage', name: `${p.name} Accessibility Checker`, url: `${SITE.url}${platformPath(p)}` })),
  },
];
---
<BaseLayout
  title="Platform Accessibility Checkers: Builders and Hosts | AccessBell"
  description="Free platform accessibility checkers for WordPress, Shopify, WooCommerce, Wix, Drupal and more, plus web hosts like GoDaddy. Scan any page for WCAG issues."
  breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Platforms', href: PATH }]}
  schema={schema}
>
  <section class="checker-hero" id="scan" aria-labelledby="platforms-title">
    <div class="container">
      <span class="eyebrow">Free Tools</span>
      <h1 id="platforms-title">Accessibility Checkers by Platform</h1>
      <p class="lead">Free platform accessibility checkers for the e-commerce platforms, CMSs, site builders and web hosts most websites run on. Scan any public page below, or pick your platform to see the WCAG issues it causes most often and how to fix them in your theme, plugins or apps.</p>
      <ScanForm id="platforms" buttonLabel="Check my site" />
      <p class="checker-meta">
        <Icon name="check" /> Real Chrome browser scan, powered by axe-core
        <span aria-hidden="true">&middot;</span> Free, no account needed
      </p>
      <form class="platform-picker" data-platform-picker novalidate hidden aria-describedby="platform-picker-error">
        <label for="platform-picker-select">Or choose your platform to go straight to its checker</label>
        <div class="platform-picker-row">
          <select id="platform-picker-select" name="platform" required>
            <option value="">Choose your platform</option>
            {GROUPS.map((g) => (
              <optgroup label={g.optgroup}>
                {PLATFORMS.filter((p) => p.group === g.id).map((p) => <option value={platformPath(p)}>{p.name}</option>)}
              </optgroup>
            ))}
          </select>
          <button class="btn btn-accent" type="submit">View checker <Icon name="arrow" /></button>
        </div>
        <p class="scan-error" id="platform-picker-error" role="alert" hidden></p>
      </form>
    </div>
  </section>

  <section class="results" id="scan-results" aria-live="polite" aria-busy="false" hidden>
    <div class="container" data-results></div>
  </section>

  {GROUPS.map((g) => (
    <section class="section-tight" aria-labelledby={`platforms-${g.id}`}>
      <div class="container">
        <div class="section-head section-head-left">
          <h2 id={`platforms-${g.id}`}>{g.heading}</h2>
          <p>{g.intro}</p>
        </div>
        <ul class="res-grid">
          {PLATFORMS.filter((p) => p.group === g.id).map((p) => (
            <li>
              <a class="res-card" href={platformPath(p)}>
                <span class="res-card-logo"><PlatformLogo slug={p.slug} name={p.name} /></span>
                <span class="res-card-text">
                  <small>{g.label}</small>
                  <strong>{p.name} Accessibility Checker</strong>
                  <span>{p.lead}</span>
                </span>
                <Icon name="arrow" class="res-arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section-tight" aria-labelledby="platforms-why">
    <div class="container cc-prose">
      <h2 id="platforms-why">Why Use a Platform Accessibility Checker?</h2>
      <p>Most accessibility problems on a website do not come from the platform itself. They come from what is added on top: the theme, page-builder blocks, plugins, apps, embedded widgets and the content people publish. A platform accessibility checker points you at the parts you can actually change on your platform, such as a theme setting, a plugin or an app, rather than just the failing HTML.</p>
      <p class="logo-note">{PLATFORMS.length} platforms covered. Platform names and logos are trademarks of their owners and are used only to identify each platform. AccessBell is not affiliated with any of them.</p>
      <p>Every checker tests your pages against the W3C's <a href="https://www.w3.org/TR/WCAG22/" rel="noopener noreferrer">Web Content Accessibility Guidelines (WCAG) 2.2</a>. Automated scans find many, but not all, accessibility problems, so each checker also lists what to test by hand. The W3C's <a href="https://www.w3.org/WAI/test-evaluate/" rel="noopener noreferrer">evaluating web accessibility overview</a> explains how automated and manual testing fit together, and our guide to <a href="/blog/automated-vs-manual-accessibility-testing">automated vs manual accessibility testing</a> covers the same ground in plain English.</p>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="platforms-standards">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="platforms-standards">Accessibility Checkers by Standard</h2>
        <p>Need to meet a specific standard? These checkers preset the scan to the WCAG version and level each standard requires.</p>
      </div>
      <ul class="res-grid">
        {CHECKERS.map((c) => (
          <li>
            <a class="res-card" href={checkerPath(c)}>
              <span class="res-card-text">
                <small>WCAG {c.version} Level {c.level}</small>
                <strong>{c.name}</strong>
                <span>{c.lead.split('. ')[0]}.</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="platforms-more">
    <div class="container">
      <div class="section-head section-head-left">
        <h2 id="platforms-more">More Accessibility Scanners</h2>
        <p>Checkers framed for your industry and your state's accessibility laws, plus free color tools.</p>
      </div>
      <ul class="res-grid">
        {INDUSTRIES.map((i) => (
          <li>
            <a class="res-card" href={industryPath(i)}>
              <span class="res-card-text">
                <small>Industry checker</small>
                <strong>{i.name} Accessibility Checker</strong>
                <span>{i.lead}</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
        {STATE_LAWS.map((s) => (
          <li>
            <a class="res-card" href={stateLawPath(s)}>
              <span class="res-card-text">
                <small>State law checker</small>
                <strong>{s.name} Website Accessibility Checker</strong>
                <span>{s.lead}</span>
              </span>
              <Icon name="arrow" class="res-arrow" />
            </a>
          </li>
        ))}
        <li>
          <a class="res-card" href="/resources/contrast-checker">
            <span class="res-card-text">
              <small>Free tool</small>
              <strong>WCAG Color Contrast Checker</strong>
              <span>Check any text and background colors against WCAG AA and AAA.</span>
            </span>
            <Icon name="arrow" class="res-arrow" />
          </a>
        </li>
        <li>
          <a class="res-card" href="/resources/chart-color-checker">
            <span class="res-card-text">
              <small>Free tool</small>
              <strong>Chart Color Checker</strong>
              <span>Test chart colors for contrast and color blindness.</span>
            </span>
            <Icon name="arrow" class="res-arrow" />
          </a>
        </li>
      </ul>
      <p class="more-link"><a class="link-arrow" href="/resources">All free tools and resources <Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
<script>
  import '../../scripts/free-scan.js';

  // Platform picker: choosing a platform goes straight to its checker. The label says so up
  // front, as WCAG 3.2.2 (On Input) requires. Moving through the options with the arrow keys
  // does not navigate, so keyboard users can browse; they confirm with Enter or the button.
  const picker = document.querySelector<HTMLFormElement>('[data-platform-picker]');
  if (picker) {
    picker.hidden = false;
    const select = picker.elements.namedItem('platform') as HTMLSelectElement;
    const error = picker.querySelector<HTMLElement>('.scan-error')!;
    const BROWSING = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'];
    let browsing = false;
    const go = () => {
      if (!select.value) {
        select.setAttribute('aria-invalid', 'true');
        error.textContent = 'Choose your platform from the list first.';
        error.hidden = false;
        select.focus();
        return;
      }
      window.location.assign(select.value);
    };
    select.addEventListener('keydown', (e) => {
      if (BROWSING.includes(e.key)) browsing = true;
      else if (e.key === 'Enter' && select.value) {
        e.preventDefault();
        go();
      }
    });
    select.addEventListener('change', () => {
      select.removeAttribute('aria-invalid');
      error.hidden = true;
      if (browsing) browsing = false;
      else if (select.value) go();
    });
    picker.addEventListener('submit', (e) => {
      e.preventDefault();
      go();
    });
  }
</script>
