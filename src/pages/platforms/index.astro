---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PlatformLogo from '../../components/PlatformLogo.astro';
import { SITE } from '../../config/site';
import { PLATFORMS, platformHome, platformCheckers } from '../../data/platforms';

const PATH = '/platforms';
const GROUPS = [
  { id: 'ecommerce', heading: 'E-commerce Platforms' },
  { id: 'cms', heading: 'Content Management Systems' },
  { id: 'builder', heading: 'Website and Page Builders' },
  { id: 'framework', heading: 'Frameworks and Developer Platforms' },
  { id: 'host', heading: 'Web Hosts' },
] as const;
const n = platformCheckers(PLATFORMS[0]).length;
const url = `${SITE.url}${PATH}`;
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    name: 'Accessibility Checkers by Platform',
    url,
    isPartOf: { '@id': `${SITE.url}/#website` },
    hasPart: PLATFORMS.map((p) => ({ '@type': 'WebPage', name: `${p.name} Accessibility Checkers`, url: `${SITE.url}${platformHome(p)}` })),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: PLATFORMS.length,
      itemListElement: PLATFORMS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `${p.name} Accessibility Checkers`, url: `${SITE.url}${platformHome(p)}` })),
    },
  },
];
---
<BaseLayout
  title="Platform Accessibility Checkers | AccessBell"
  description="Pick your platform to find free accessibility checkers for WordPress, Shopify, WooCommerce, Wix, Drupal and more, including WCAG and ADA compliance checkers."
  breadcrumbs={[{ label: 'Platforms', href: PATH }]}
  schema={schema}
>
  <section class="page-hero page-hero-center" aria-labelledby="platforms-title">
    <div class="container">
      <h1 id="platforms-title">Accessibility Checkers by Platform</h1>
      <p class="lead">Choose your platform to see the free accessibility checkers available for it, including WCAG and ADA compliance checkers.</p>
    </div>
  </section>

  {GROUPS.map((g) => (
    <section class="section-tight pt-0" aria-labelledby={`platforms-${g.id}`}>
      <div class="container">
        <h2 id={`platforms-${g.id}`} class="platform-tiles-heading">{g.heading}</h2>
        <ul class="platform-tiles">
          {PLATFORMS.filter((p) => p.group === g.id).map((p) => (
            <li>
              <a class="platform-tile" href={platformHome(p)}>
                <PlatformLogo slug={p.slug} name={p.name} size="lg" />
                <strong>{p.name}</strong>
                <small>{n} checkers</small>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section-tight" aria-labelledby="platforms-note">
    <div class="container cc-prose">
      <h2 id="platforms-note" class="visually-hidden">About these checkers</h2>
      <p class="logo-note">Every checker runs the same free scan on a public page, with no account. Platform names and logos are trademarks of their owners and are used only to identify each platform. AccessBell is not affiliated with any of them. Every checker tests against the W3C’s <a href="https://www.w3.org/TR/WCAG22/" rel="noopener noreferrer" target="_blank">Web Content Accessibility Guidelines<span class="visually-hidden"> (opens in a new tab)</span></a>. Not sure which to pick? Start with the <a href="/#scan">free website accessibility scan</a> or read about our <a href="/solutions">accessibility solutions</a>.</p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
