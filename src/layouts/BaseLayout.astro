---
import '../styles/global.css';
import { SITE, absoluteUrl, normalizePath } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';

interface Props {
  /** Full <title>. Keep under ~60 characters. */
  title: string;
  /** Meta description. Aim for 140-160 characters. */
  description: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Breadcrumb trail after "Home". Omit on the homepage. */
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  article?: { published: string; modified?: string; section?: string };
}

const {
  title,
  description,
  image = SITE.ogImage,
  imageAlt = 'AccessBell - Website Accessibility Checker',
  ogType = 'website',
  noindex = false,
  breadcrumbs,
  schema = [],
  article,
} = Astro.props;

const pathname = normalizePath(Astro.url.pathname);
const canonical = absoluteUrl(pathname);
const imageUrl = new URL(image, SITE.url).toString();

const crumbs: Crumb[] | undefined = breadcrumbs ? [{ label: 'Home', href: '/' }, ...breadcrumbs] : undefined;

const orgId = `${SITE.url}/#organization`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png`, width: 512, height: 512 },
    email: SITE.email,
    sameAs: Object.values(SITE.social),
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': orgId },
    inLanguage: 'en-US',
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    inLanguage: 'en-US',
    primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl },
    ...(crumbs ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  },
];
if (crumbs) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: absoluteUrl(c.href),
    })),
  });
}
graph.push(...schema);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#353A47" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="AccessBell Blog" href="/rss.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <JsonLd data={{ '@context': 'https://schema.org', '@graph': graph }} />
    <script is:inline src="/js/main.js" defer></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      {crumbs && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
