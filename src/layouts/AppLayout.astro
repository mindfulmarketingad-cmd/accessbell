---
import GoogleTag from '../components/GoogleTag.astro';
import '../styles/global.css';
import '../styles/app.css';
import LogoMark from '../components/LogoMark.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  /** Sidebar item to highlight. */
  section?: 'overview' | 'team' | 'billing' | 'account' | 'free-scans';
}
const { title, section = 'overview' } = Astro.props;
const nav = [
  { id: 'team', label: 'Team', href: '/app/team', icon: 'users' },
  { id: 'billing', label: 'Billing', href: '/app/billing', icon: 'card' },
  { id: 'account', label: 'Account settings', href: '/app/account', icon: 'gear' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <GoogleTag />
    <title>{`${title} | AccessBell`}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#353A47" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class="app-body">
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="app-shell" data-shell>
      <header class="app-topbar">
        <button class="icon-btn" type="button" data-side-open aria-controls="app-side" aria-expanded="false">
          <Icon name="menu" /><span class="visually-hidden">Open menu</span>
        </button>
        <a class="brand" href="/app"><LogoMark /><span>Access<span class="brand-bell">Bell</span></span></a>
      </header>
      <div class="side-backdrop" data-side-backdrop hidden></div>

      <aside class="app-side" id="app-side" aria-label="Dashboard">
        <div class="side-top">
          <a class="brand" href="/app" aria-label="AccessBell dashboard">
            <LogoMark />
            <span class="side-text">Access<span class="brand-bell">Bell</span></span>
          </a>
          <button class="icon-btn side-collapse" type="button" data-side-collapse aria-controls="app-side" aria-expanded="true">
            <Icon name="panel" /><span class="visually-hidden" data-collapse-label>Collapse sidebar</span>
          </button>
        </div>

        <div class="workspace" data-workspace>
          <span class="avatar avatar-sage" data-workspace-initial aria-hidden="true"></span>
          <span class="side-text">
            <strong data-account-name></strong>
            <small data-account-members></small>
          </span>
        </div>

        <nav aria-label="Dashboard sections" class="side-nav">
          <p class="side-label side-text">Key tools</p>
          <ul class="app-nav">
            <li class="nav-group">
              <div class="nav-row">
                <a href="/app" aria-current={section === 'overview' ? 'page' : undefined} data-nav-domains>
                  <Icon name="list" /><span class="side-text">Domains</span>
                </a>
                <button class="icon-btn nav-toggle side-text" type="button" data-domains-toggle aria-expanded="true" aria-controls="side-domains">
                  <Icon name="chevron" /><span class="visually-hidden">Show or hide domains</span>
                </button>
              </div>
              <ul class="nav-sub side-text" id="side-domains" data-side-domains></ul>
            </li>
            <li data-admin-nav hidden>
              <a href="/app/free-scans" aria-current={section === 'free-scans' ? 'page' : undefined}>
                <Icon name="scan" /><span class="side-text">Free scans</span>
              </a>
            </li>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={n.id === section ? 'page' : undefined}>
                  <Icon name={n.icon} /><span class="side-text">{n.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="side-foot">
          <p class="side-label side-text">Account</p>
          <ul class="app-nav">
            <li>
              <a href="/app?tour=dashboard" data-tour-replay><Icon name="sparkle" /><span class="side-text">Product tour</span></a>
            </li>
            <li>
              <a href="/resources/help-center"><Icon name="doc" /><span class="side-text">Help Center</span></a>
            </li>
            <li>
              <a href="/contact?topic=support"><Icon name="chat" /><span class="side-text">Support</span></a>
            </li>
          </ul>
          <div class="user-card">
            <span class="avatar" data-user-initials aria-hidden="true"></span>
            <span class="side-text user-text">
              <strong data-account-label></strong>
              <small data-user-email></small>
            </span>
            <div class="menu-wrap side-text">
              <button class="icon-btn" type="button" data-user-menu aria-expanded="false" aria-controls="user-menu">
                <Icon name="more" /><span class="visually-hidden">Account menu</span>
              </button>
              <div class="menu" id="user-menu" hidden>
                <a href="/app/account">Account settings</a>
                <a href="/app/billing">Billing</a>
                <button type="button" data-signout>Sign out</button>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <main id="main" class="app-main" tabindex="-1">
        <div class="app-banner-slot" data-banner></div>
        <slot />
      </main>
    </div>
  </body>
</html>
