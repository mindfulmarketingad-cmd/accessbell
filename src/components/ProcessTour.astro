---
/**
 * "How it works" steps with an illustration for each step. The steps advance
 * on their own with a progress bar; visitors can pick a step or pause. The
 * illustrations are decorative, so the step text carries all the meaning.
 */
import Icon from './Icon.astro';

interface Props {
  steps: { tag: string; title: string; text: string }[];
}
const { steps } = Astro.props;

const pages = [
  { path: '/', source: 'Sitemap', on: true },
  { path: '/pricing', source: 'Sitemap', on: true },
  { path: '/checkout', source: 'Crawl', on: true },
  { path: '/blog', source: 'Sitemap', on: true },
  { path: '/blog/spring-sale', source: 'Crawl', on: false },
  { path: 'shop.example.com', source: 'Subdomain', on: true },
];
const issues = [
  { title: 'Image has no text alternative', sc: '1.1.1', count: 14, impact: 'critical' },
  { title: 'Form field has no label', sc: '1.3.1', count: 6, impact: 'critical' },
  { title: 'Text contrast is too low', sc: '1.4.3', count: 21, impact: 'serious' },
];
---
<div class="tour" data-tour>
  <div class="tour-visual" aria-hidden="true">
    <span class="tour-rail"></span>

    <!-- 1. Automatic crawl -->
    <div class="tour-scene tour-crawl is-active" data-scene>
      <div class="tour-card">
        <div class="tour-card-head">
          <strong>Discovered pages</strong>
          <span class="tour-muted">example.com</span>
        </div>
        <ul class="tour-pages">
          {pages.map((p) => (
            <li class:list={{ 'is-on': p.on }}>
              <span class="tour-box"><Icon name="check" /></span>
              <span class="tour-path">{p.path}</span>
              <span class="tour-chip">{p.source}</span>
            </li>
          ))}
        </ul>
        <div class="tour-card-foot">
          <span>Monitoring</span>
          <strong>5 of 500 URLs</strong>
        </div>
      </div>
    </div>

    <!-- 2. Scan -->
    <div class="tour-scene tour-scan" data-scene>
      <div class="tour-devices">
        <div class="tour-desktop">
          <div class="tour-desktop-bar"><i></i><i></i><i></i></div>
          <div class="tour-skeleton">
            <span class="w-60 tall"></span><span class="w-80"></span><span class="w-70"></span>
            <div class="tour-skeleton-grid"><span></span><span></span><span></span></div>
            <span class="w-90"></span><span class="w-50"></span>
          </div>
        </div>
        <div class="tour-phone">
          <div class="tour-skeleton">
            <span class="w-80 tall"></span><span class="w-90"></span><span class="w-60"></span>
            <span class="block"></span><span class="w-70"></span><span class="w-50"></span>
          </div>
        </div>
        <span class="tour-beam"></span>
      </div>
      <ul class="tour-issues">
        {issues.map((i) => (
          <li>
            <span class={`tour-sev tour-sev-${i.impact}`}></span>
            <span class="tour-issue-title">{i.title}</span>
            <span class="tour-chip">WCAG {i.sc}</span>
            <strong>{i.count}</strong>
          </li>
        ))}
      </ul>
    </div>

    <!-- 3. Improve -->
    <div class="tour-scene tour-fix" data-scene>
      <div class="tour-task is-done">
        <span class="tour-task-num"><Icon name="check" /></span>
        <span>Image has no text alternative</span>
        <em>Fixed</em>
      </div>
      <div class="tour-task is-current">
        <span class="tour-task-num">2</span>
        <span>Form field has no label</span>
        <em>In progress</em>
      </div>
      <div class="tour-card tour-howto">
        <div class="tour-card-head">
          <strong>How to fix</strong>
          <span class="tour-chip">Header component, 25 pages</span>
        </div>
        <ol>
          <li>Give the search input a visible label.</li>
          <li>Connect it with a matching <code>for</code> and <code>id</code>.</li>
        </ol>
        <div class="tour-code">
          <span class="del">- &lt;input type="search"&gt;</span>
          <span class="add">+ &lt;label for="q"&gt;Search&lt;/label&gt;</span>
          <span class="add">+ &lt;input id="q" type="search"&gt;</span>
        </div>
      </div>
      <div class="tour-task is-next">
        <span class="tour-task-num">3</span>
        <span>Text contrast is too low</span>
        <em>Next</em>
      </div>
    </div>

    <!-- 4. Keep monitoring -->
    <div class="tour-scene tour-monitor" data-scene>
      <div class="tour-card tour-status">
        <div class="tour-ring"><span>94</span></div>
        <div class="tour-status-body">
          <strong class="tour-pass"><Icon name="check" /> WCAG 2.2 AA</strong>
          <dl>
            <div><dt>Open issues</dt><dd>3</dd></div>
            <div><dt>Fixed issues</dt><dd>38</dd></div>
            <div><dt>Last scan</dt><dd>Today</dd></div>
            <div><dt>Next scan</dt><dd>Tomorrow</dd></div>
          </dl>
        </div>
      </div>
      <div class="tour-card tour-history">
        <div class="tour-card-head">
          <strong>Score history</strong>
          <span class="tour-muted">Last 12 weeks</span>
        </div>
        <svg viewBox="0 0 320 110" preserveAspectRatio="none">
          <path class="tour-grid" d="M0 20H320M0 55H320M0 90H320" />
          <path class="tour-area" d="M0 92 C40 88 60 80 90 74 S150 60 180 50 S250 30 320 18 V110 H0Z" />
          <path class="tour-line" pathLength="1" d="M0 92 C40 88 60 80 90 74 S150 60 180 50 S250 30 320 18" />
          <circle class="tour-dot" cx="320" cy="18" r="5" />
        </svg>
      </div>
    </div>

    <span class="tour-badge"><Icon name="check" /></span>
  </div>

  <div class="tour-side">
    <ol class="tour-steps">
      {steps.map((s, i) => (
        <li class:list={['tour-step', { 'is-active': i === 0 }]} data-step>
          <small>{s.tag}</small>
          <h3><button type="button" class="tour-step-btn" aria-current={i === 0 ? 'step' : undefined}>{s.title}</button></h3>
          <p>{s.text}</p>
          <span class="tour-progress" aria-hidden="true"><i></i></span>
        </li>
      ))}
    </ol>
    <button type="button" class="tour-toggle" data-tour-toggle hidden>
      <span class="tour-toggle-pause">Pause animation</span>
      <span class="tour-toggle-play">Play animation</span>
    </button>
  </div>
</div>

<script>
  import { initTour } from '../scripts/process-tour.js';
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach(initTour);
</script>
