---
interface Link {
  href: string;
  label: string;
}
interface Props {
  id: string;
  title: string;
  intro?: string;
  links: Link[];
}
const { id, title, intro, links } = Astro.props;
---
{links.length > 0 && (
  <section class="guide-series" aria-labelledby={id}>
    <h2 id={id}>{title}</h2>
    {intro && <p>{intro}</p>}
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </section>
)}
