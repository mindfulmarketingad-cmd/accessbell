---
import { HEADER_NAV, normalizePath } from '../config/site';
import LogoMark from './LogoMark.astro';
import Icon from './Icon.astro';

const path = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="AccessBell home">
        <LogoMark />
        <span>Access<span class="brand-bell">Bell</span></span>
      </a>
      <nav class="primary-nav" id="primary-nav" aria-label="Primary">
        <ul>
          {HEADER_NAV.map((item) => (
            'children' in item && item.children ? (
              <li class="nav-has-children">
                <button
                  type="button"
                  class="nav-dropdown-trigger"
                  aria-expanded="false"
                  aria-controls={`nav-dd-${item.label.toLowerCase()}`}
                  data-nav-dropdown-trigger
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <Icon name="chevron" />
                </button>
                <ul class="nav-dropdown" id={`nav-dd-${item.label.toLowerCase()}`} hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        <span>{child.label}</span>
                        {child.note && <small>{child.note}</small>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            )
          ))}
        </ul>
      </nav>
      <div class="header-cta">
        <a class="header-link" href="/app">Dashboard</a>
        <a class="btn btn-green" href="/app/signup">Start free trial</a>
        <button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" data-nav-toggle>
          <Icon name="menu" />
          <span class="visually-hidden">Menu</span>
        </button>
      </div>
    </div>
  </div>
</header>
