---
import ScanForm from './ScanForm.astro';
import Icon from './Icon.astro';
import { ONE_TIME, PLAN } from '../data/pricing';

interface Props {
  title?: string;
  text?: string;
  /** Show the scan form (homepage) or plain buttons (other pages). */
  withForm?: boolean;
}
const {
  title = 'Scan a Page, Then Monitor and Fix',
  text = `The free scan shows the issues on one public page. A 3-day free trial then monitors up to ${PLAN.urlsPerDomain} URLs per domain and lets you apply fixes you approve, such as alt text, button names and the page language. Nothing is applied until you approve it.`,
  withForm = false,
} = Astro.props;
---
<section class="section-tight" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-band">
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
      {withForm ? (
        <>
          <ScanForm id="cta" buttonLabel="Run free check" />
          <ul class="scan-meta">
            <li><Icon name="check" />Free, no account needed</li>
            <li><Icon name="check" />Results in under 30 seconds</li>
            <li><Icon name="check" />Mapped to WCAG success criteria</li>
          </ul>
          <p class="cta-note">Want to monitor the site and apply fixes you approve? <a href="/app/signup">Start a 3-day free trial</a>, then ${PLAN.price} per domain per month or ${PLAN.annualPrice} per year. You add a card at checkout and are not charged until the trial ends. This is not an overlay.</p>
        </>
      ) : (
        <>
          <div class="cta-actions">
            <a class="btn btn-accent btn-lg" href="/app/signup">Start 3-day free trial <Icon name="arrow" /></a>
            <a class="btn btn-outline btn-lg" href="/#scan">Run a free scan</a>
          </div>
          <p class="cta-note">Pro is a 3-day free trial, then ${PLAN.price} per domain per month or ${PLAN.annualPrice} per year. You add a card at checkout and are not charged until the trial ends. Cancel before then and you will not be charged.</p>
          <p class="cta-note">Not ready for a subscription? A <a href={ONE_TIME.pageReport.href}>Page Report</a> is ${ONE_TIME.pageReport.price} for one page, and a <a href={ONE_TIME.domainAudit.href}>Domain Audit</a> is ${ONE_TIME.domainAudit.price} for up to {PLAN.urlsPerDomain} pages.</p>
        </>
      )}
    </div>
  </div>
</section>
