---
import ScanForm from './ScanForm.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  /** Show the scan form (homepage) or plain buttons (other pages). */
  withForm?: boolean;
}
const {
  title = 'Find Out if Your Website Is Accessible',
  text = 'Start a 3-day free trial to monitor every page on your domain, or run a free one-page WCAG check right now with no sign-up.',
  withForm = false,
} = Astro.props;
---
<section class="section-tight" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-band">
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
      {withForm ? (
        <>
          <ScanForm id="cta" buttonLabel="Run free check" />
          <ul class="scan-meta">
            <li><Icon name="check" />Free, no account needed</li>
            <li><Icon name="check" />Results in under 30 seconds</li>
            <li><Icon name="check" />Mapped to WCAG success criteria</li>
          </ul>
          <p class="cta-note">Want every page monitored? <a href="/app/signup">Start a 3-day free trial</a>.</p>
        </>
      ) : (
        <>
          <div class="cta-actions">
            <a class="btn btn-accent btn-lg" href="/app/signup">Start 3-day free trial <Icon name="arrow" /></a>
            <a class="btn btn-outline btn-lg" href="/#scan">Run a free scan</a>
          </div>
          <p class="cta-note">Then $29/mo per domain. Cancel anytime.</p>
        </>
      )}
    </div>
  </div>
</section>
