---
import { STANDARDS } from '../config/site';
import { ONE_TIME, PLAN } from '../data/pricing';
import Icon from './Icon.astro';

interface Props {
  /** Unique id prefix when more than one form is on a page. */
  id: string;
  buttonLabel?: string;
  /** Standard selected by default, for checker pages. */
  standard?: string;
}
const { id, buttonLabel = 'Check accessibility', standard } = Astro.props;
---
<form class="scan-form" data-scan-form novalidate aria-describedby={`${id}-error`}>
  <div class="scan-field">
    <Icon name="globe" />
    <label class="visually-hidden" for={`${id}-url`}>Website URL to check</label>
    <input
      id={`${id}-url`}
      name="url"
      type="text"
      inputmode="url"
      autocomplete="url"
      spellcheck="false"
      autocapitalize="off"
      placeholder="Enter your website URL"
      maxlength="2048"
      required
    />
  </div>
  <div>
    <label class="visually-hidden" for={`${id}-standard`}>Accessibility standard</label>
    <select id={`${id}-standard`} name="standard">
      {STANDARDS.map((s) => <option value={s.id} selected={s.id === standard}>{s.label}</option>)}
    </select>
  </div>
  <button class="btn btn-accent" type="submit">
    {buttonLabel}
    <Icon name="arrow" />
  </button>
</form>
<p class="scan-error" id={`${id}-error`} role="alert" data-scan-error hidden></p>
<p class="scan-proof scan-proof-form">
  <span data-scan-proof-count hidden></span>
  <slot name="proof">
    <span>Free scan of one public page, no account. <a href="/app/signup">Start a 3-day free trial</a> of Pro, then ${PLAN.price} per domain per month or ${PLAN.annualPrice} per year. A card is added at checkout, and you are not charged until the trial ends. The first charge has a 14-day money-back guarantee. Guided fix suggestions apply only after you approve them. A <a href={ONE_TIME.pageReport.href}>Page Report</a> is ${ONE_TIME.pageReport.price} and a <a href={ONE_TIME.domainAudit.href}>Domain Audit</a> is ${ONE_TIME.domainAudit.price}. Neither renews.</span>
  </slot>
</p>
<noscript><p class="scan-error">The free checker needs JavaScript enabled to display results.</p></noscript>
